    flex-shrink: 0;
    padding-left: 3px;
    padding-right: 3px;
}

.results-session-performance { flex-grow: 3; }
.results-session-body > .results-weather { flex-grow: 1; }
.results-session-lap-mph { flex-shrink: 0; font-size: 11px; margin-left: 12px; -unity-text-align: middle-right; }

