#resultsPage,
#resultsPage Label,
#resultsPage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}
#resultsPage { flex-grow: 1; min-height: 0; }
#resultsPage .team-results-panel { flex-grow: 1; flex-basis: 0; min-height: 0; padding: 18px 12px 10px; }
#resultsPage .team-home-heading { color: #009bdd; }
#resultsPage .settings-field { flex-shrink: 0; margin-bottom: 6px; }
#resultsPage .settings-field > .settings-button { align-self: flex-start; border-radius: 8px; border-color: #009bdd; }
#resultsPage .team-results-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
#resultsPage .results-grid { margin-top: 0; }
#resultsPage .results-grid-row { height: 22px; min-height: 22px; flex-shrink: 0; }
#resultsPage .results-grid-row.results-grid-header { height: 26px; min-height: 26px; }
#resultsPage .results-grid-cell {
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 1px 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Event selector stays content-sized; the results list receives the remaining height. */
#resultsPage .team-results-panel > .settings-field {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin: 0 0 6px;
}
#resultsPage .team-results-panel > .settings-field > .settings-note { margin: 0 0 2px; }
#resultsPage .team-results-panel > .settings-field > .settings-button { margin: 0; }

#resultsPage .results-selection-row { flex-direction: row; flex-shrink: 0; align-items: flex-start; margin-bottom: 6px; }
#resultsPage .results-selection-row > .settings-field { flex-grow: 0; flex-shrink: 1; flex-basis: auto; margin: 0 12px 0 0; }
#resultsPage .results-selection-row > .settings-field > .settings-note { margin: 0 0 2px; }
#resultsPage .results-selection-row > .settings-field > .settings-button { margin: 0; min-width: 160px; border-color: #009bdd; }

.results-grid-row > .results-position { flex-grow: 0; flex-shrink: 0; flex-basis: 60px; }
.results-grid-row > .results-car-image {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 62px;
    width: 62px;
    height: 28px;
    padding: 0 3px;
    background-color: transparent;
}
.results-grid-row > .results-car-number { flex-grow: 0; flex-shrink: 0; flex-basis: 70px; }
#resultsPage .results-grid-row { height: 30px; min-height: 30px; align-items: center; }
#resultsPage .results-grid-row.results-grid-header { height: 26px; min-height: 26px; }

.results-grid-row > .results-car-image {
    flex-basis: 106px;
    width: 106px;
    height: 56px;
}
#resultsPage .results-grid-row { height: 60px; min-height: 60px; }
#resultsPage .results-grid-row.results-grid-header { height: 26px; min-height: 26px; }
.results-grid-header > .results-car-image { height: auto; }

/* Reserve narrow identity-number columns and prioritize full driver/team names. */
.results-grid-row > .results-position { flex-basis: 36px; }
.results-grid-row > .results-car-number { flex-basis: 44px; }
#resultsPage .results-grid-row > .results-grid-name {
    flex-grow: 3;
    flex-shrink: 1;
    flex-basis: 0;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
}

.results-grid-row > .results-laps { flex-grow: 0; flex-shrink: 0; flex-basis: 42px; }
#resultsPage .results-grid-scrollable { flex-grow: 1; flex-basis: 0; min-height: 0; }
#resultsPage .results-grid-scrollable > .results-grid-header { flex-shrink: 0; }
#resultsPage .results-body-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }

#resultsPage .team-results-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
#resultsPage .team-results-panel { flex-grow: 2; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: 12px; }
#resultsPage .team-results-details { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 18px 12px 10px; }
#resultsPage .results-details-scroll { flex-grow: 1; min-height: 0; }
#resultsPage .results-player-row { background-color: #155374; border-left-width: 3px; border-left-color: #55c4ef; }
.results-details-track { height: 74px; flex-shrink: 0; margin: 5px 0 8px; }
.results-session-summary { padding: 8px; margin-top: 8px; border-width: 1px; border-color: #34495f; border-radius: 8px; flex-shrink: 0; }
.results-session-current { border-color: #009bdd; }
.results-session-name { color: #55c4ef; font-size: 13px; white-space: normal; margin: 0 0 4px; }
.results-weather { flex-direction: row; align-items: center; padding: 6px; margin-top: 6px; border-width: 1px; border-color: #34495f; border-radius: 5px; background-color: #263e50; }
.results-weather-night { background-color: #0b101b; }
.results-weather-icon { width: 42px; height: 36px; flex-shrink: 0; margin-right: 8px; }
.results-weather-title { font-size: 12px; margin: 0; }

.results-fixed-track-info { flex-shrink: 0; }
#resultsPage .results-details-scroll { flex-basis: 0; }
.results-session-summary:hover,
.results-session-summary:focus { border-color: #55c4ef; }

.results-grid-row > .results-fastest-lap {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 100px;
}
.results-grid-row > .results-best-lap-mph {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 112px;
}

.results-session-body { flex-direction: row; align-items: stretch; }
.results-session-performance { flex-grow: 2; flex-shrink: 1; flex-basis: 0; min-width: 0; padding-right: 8px; }
.results-session-body > .results-weather {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin-top: 0;
    padding: 5px;
}
.results-session-body .results-weather-icon { align-self: center; margin: 0 0 4px; }
.results-session-body .results-weather .team-home-race-detail { white-space: normal; }
.results-session-leader-car { height: 66px; flex-shrink: 0; background-color: transparent; }
.results-session-leader-label { font-size: 11px; color: #55c4ef; margin: 2px 0; }
.results-session-driver { font-size: 12px; white-space: normal; margin: 0; }
.results-session-player { font-size: 11px; color: #55c4ef; white-space: normal; margin: 5px 0 0; }

.results-session-driver-line { flex-direction: row; align-items: center; }
.results-session-driver-line > .results-session-driver { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.results-session-lap-time { flex-shrink: 0; font-size: 11px; margin-left: 6px; -unity-text-align: middle-right; }

/* Content-sized, compact session and weather summaries. */
.results-session-summary { padding: 6px; margin-top: 6px; }
.results-session-name { margin: 0 0 3px; }
.results-session-body { align-items: flex-start; }
.results-session-performance { padding-right: 6px; }
.results-session-leader-label { margin: 0 0 2px; }
.results-session-player { margin-top: 3px; }
.results-session-body > .results-weather {
    flex-grow: 1;
    align-self: flex-start;
    justify-content: flex-start;
    padding: 4px;
    margin-top: 0;
}
.results-session-body .results-weather-icon { height: 32px; margin: 0 0 2px; }
.results-weather-line { flex-direction: row; align-items: center; align-self: stretch; min-width: 0; }
.results-weather-description { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 10px; white-space: normal; margin: 0; padding: 0; }
.results-weather-temperature { flex-shrink: 0; font-size: 10px; margin: 0 0 0 4px; padding: 0; -unity-text-align: middle-right; }

.results-session-body { align-items: stretch; }
.results-session-body > .results-weather {
    align-self: stretch;
    align-items: center;
    justify-content: center;
}
.results-session-body .results-weather-line { align-self: stretch; }

.results-event-chassis { font-size: 11px; white-space: normal; margin: 2px 0 6px; }

#teamStandingsRows .standings-car-number {
