.screen {
    flex-grow: 1;
    padding: 26px 40px;
    background-color: #10151e;
    color: #f5f7fa;
}
.header, .footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 42px;
    border-color: #394350;
}
.header { border-bottom-width: 1px; }
.footer { border-top-width: 1px; }
.brand, .eyebrow, .muted {
    font-size: 14px;
    -unity-font-style: bold;
}
.brand, .accent, .eyebrow { color: #ffaf63; }
.muted { color: #aab7c8; }
.main {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}
.card {
    width: 100%;
    max-width: 740px;
    padding: 26px 34px;
    background-color: #1c2633;
    border-left-width: 5px;
    border-left-color: #ffaf63;
}
.eyebrow { margin-bottom: 14px; }
.title {
    font-size: 54px;
    -unity-font-style: bold;
    margin: 0;
}
.description {
    color: #c9d3e0;
    font-size: 19px;
    white-space: normal;
    margin-top: 14px;
    margin-bottom: 19px;
}
.action {
    align-self: flex-start;
    min-width: 170px;
    height: 44px;
    margin: 0;
    color: #141a22;
    background-color: #ffaf63;
    border-color: #ffaf63;
    font-size: 17px;
    -unity-font-style: bold;
}
.action:hover, .action:focus {
    background-color: #ffd2a7;
    border-color: #ffffff;
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
}
.quit-action {
    min-width: 90px;
    margin-left: 12px;
    color: #f5f7fa;
    background-color: #263342;
    border-color: #64768b;
}
.quit-action:hover, .quit-action:focus {
    background-color: #394a60;
    border-color: #ffffff;
}

.garage-entry {
    padding: 12px 16px;
    margin-bottom: 18px;
    background-color: #10151e;
}
.garage-detail {
    margin: 2px 0;
    color: #c9d3e0;
    font-size: 16px;
    white-space: normal;
}

.track-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
}
.track-heading .action { align-self: center; }
.track-heading .eyebrow { margin-bottom: 0; }
.track-title {
    font-size: 36px;
    -unity-font-style: bold;
}
.race-viewport {
    flex-basis: 0;
    min-width: 0;
    flex-grow: 1;
    margin-bottom: 12px;
    background-color: #192b2b;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.tracks-editor .unity-base-field__label,
.setup-preset-name .unity-base-field__label,
.setup-notes .unity-base-field__label {
    color: #e3e9f2;
}
.tracks-editor .unity-base-text-field__input,
.setup-preset-name .unity-base-text-field__input,
.setup-notes .unity-base-text-field__input {
    background-color: #202b39;
    border-color: #69798c;
    color: #f5f7fa;
    --unity-cursor-color: #ffffff;
    --unity-selection-color: #315b87;
}
.tracks-editor .unity-base-text-field__input:focus,
.setup-preset-name .unity-base-text-field__input:focus,
.setup-notes .unity-base-text-field__input:focus {
    border-color: #ffaf63;
}
.tracks-editor .unity-base-text-field__input .unity-text-element,
.setup-preset-name .unity-base-text-field__input .unity-text-element,
.setup-notes .unity-base-text-field__input .unity-text-element {
    color: #f5f7fa;
    --unity-cursor-color: #ffffff;
    --unity-selection-color: #315b87;
}

.track-utility #utilityTitle {
    font-size: 30px;
    -unity-font-style: bold;
    margin-right: 20px;
}
.track-utility .utility-button {
    min-width: 0;
    height: 32px;
    padding: 0 12px;
    margin: 3px 8px 3px 0;
    font-size: 14px;
}
.utility-body {
    flex-grow: 1;
    flex-wrap: nowrap;
    min-height: 0;
    margin-top: 10px;
}
.utility-sidebar {
    width: 32%;
    min-width: 0;
    padding-right: 8px;
    flex-direction: row;
}
.utility-form {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding-right: 8px;
}
.utility-tabs {
    width: 140px;
    flex-shrink: 0;
    margin-right: 8px;
}
.utility-tab {
    min-height: 34px;
    margin: 0 0 4px 0;
    padding: 5px 8px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: #e3e9f2;
    background-color: #202b39;
    border-color: #394350;
}
.utility-tab-selected, .utility-tab-selected:hover {
    color: #141a22;
    background-color: #ffaf63;
    border-color: #ffaf63;
}
.utility-form .unity-base-field__label { min-width: 0; }
.utility-map {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    background-color: #17212b;
}
.utility-section {
    color: #ffaf63;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 4px;
}

.utility-tab-row {
    flex-wrap: nowrap;
    align-items: center;
}
.utility-tab-row .utility-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.utility-visibility {
    flex-shrink: 0;
    margin: 0 3px 4px 0;
}
/* Shared neutral palette. Apply game-neutral to a screen to use it. */
.game-neutral {
    --game-background: #151515;
    --game-surface: #222222;
    --game-button: #454545;
    --game-button-hover: #565656;
    --game-button-selected: #626262;
    --game-text: #f5f5f5;
    --game-divider: #b6b6b6;
    background-color: var(--game-background);
    color: var(--game-text);
}
.game-neutral .nav-button {
    color: var(--game-text);
    background-color: var(--game-button);
    border-color: var(--game-button);
    min-height: 34px;
    padding: 4px 8px;
}
.game-neutral .nav-button:hover, .game-neutral .nav-button:focus {
    background-color: var(--game-button-hover);
    border-color: var(--game-divider);
}
.game-neutral .nav-button-selected {
    background-color: var(--game-button-selected);
    border-bottom-color: var(--game-divider);
}
.garage-heading {
    color: #009bdd;
    font-size: 22px;
    -unity-font-style: bold;
}
.garage-body {
    flex-grow: 1;
    min-height: 0;
}
.mail-page, .mail-email-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.mail-email, .mail-social, .mail-inbox, .mail-reader {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
.mail-email, .mail-reader {
    flex-grow: 2;
}
.mail-social, .mail-inbox {
    flex-grow: 1;
}
.mail-social {
    margin-left: 18px;
    padding-left: 14px;
    border-left-width: 1px;
    border-left-color: var(--game-divider);
}
.mail-inbox {
    margin-right: 10px;
}
.mail-reader {
    padding: 14px;
    background-color: var(--game-surface);
    border-top-width: 2px;
    border-top-color: #4597b4;
}
.mail-scroll {
    flex-grow: 1;
    min-height: 0;
}
.mail-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}
.mail-subheading, .mail-subject {
    -unity-font-style: bold;
    white-space: normal;
}
.mail-inbox-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}
.mail-inbox-header > .mail-subheading {
    flex-grow: 1;
    align-self: center;
}
.mail-inbox-row {
    position: relative;
    flex-shrink: 0;
    margin-bottom: 5px;
}
.mail-page .mail-message-row {
    flex-grow: 1;
    min-width: 0;
    height: auto;
    min-height: 54px;
    margin: 0;
    padding: 6px 38px 6px 8px;
    align-items: stretch;
    -unity-text-align: middle-left;
}
.game-neutral .mail-page .mail-message-row.mail-unread {
    border-left-width: 3px;
    border-left-color: #36aee4;
    background-color: var(--game-button-selected);
}
.game-neutral .mail-page .mail-message-row.mail-scenario {
    border-width: 1px;
    border-color: #e55353;
}
.mail-page .mail-scenario-alert {
    color: #e55353;
    font-size: 18px;
    -unity-font-style: bold;
    align-self: center;
}
.mail-page .mail-scenario-choice {
    align-self: flex-start;
    margin: 8px 0 0;
}
.mail-sender, .mail-meta {
    font-size: 12px;
    opacity: 0.78;
    white-space: normal;
}
.mail-message-title {
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}
.mail-broadcast-logo {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
    margin-bottom: 10px;
    border-radius: 6px;
    overflow: hidden;
}
.mail-copy {
    white-space: normal;
    margin-top: 8px;
}
.mail-post {
    padding: 8px 10px;
    margin-bottom: 8px;
    background-color: var(--game-surface);
    border-left-width: 3px;
    border-left-color: #758b9b;
}
.mail-post-header {
    flex-direction: row;
    align-items: flex-start;
}
.mail-post-header > .mail-title {
    flex-grow: 1;
}
.mail-post-author {
    flex-grow: 1;
    min-width: 0;
}
.mail-post-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 18px;
    background-size: cover;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}
.mail-avatar-initials {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}
.mail-page .mail-post-delete {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 0 0 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.mail-trash-icon {
    width: 16px;
    height: 16px;
}
.mail-page .mail-inbox-delete {
    position: absolute;
    top: 6px;
    right: 6px;
    margin: 0;
}
.victory-results-background {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
}
.victory-results-background .garage-page {
    background-color: rgba(16, 21, 30, 0.63);
}
.victory-results-background .garage-page-title,
.victory-results-background .unity-base-field__label,
.garage-screen .victory-results-background .results-grid-cell {
    color: #ffffff;
}
.garage-shop-background, .garage-schedule-background, .garage-home-background, .garage-finances-background, .garage-cars-background {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
}
.garage-shop-background {
    background-image: url("RaceTeamShop.png");
}
.shop-car-picker {
    position: absolute;
    top: 22px;
    left: 12px;
    width: 350px;
    max-width: 100%;
}
.game-neutral .shop-car-toggle, .game-neutral .shop-car-choice {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 3px 6px;
    min-height: 0;
}
.shop-car-choices {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 2px;
    max-height: 420px;
    background-color: var(--game-surface);
}
.shop-car-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}
.shop-car-thumbnail {
    width: 90px;
    height: 50px;
    flex-shrink: 0;
}
.shop-car-chassis {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-center;
}
.shop-car-specs {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.shop-car-spec {
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}
.shop-car-caret {
    flex-shrink: 0;
    padding-left: 6px;
}
.shop-car-components {
    margin-top: 70px;
    padding: 3px 12px;
    background-color: rgba(15, 22, 31, 0.86);
    color: #eef5f8;
}
.shop-component-row {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    padding: 3px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(190, 222, 239, 0.22);
}
.shop-component-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 16px;
}
.shop-component-metric, .shop-component-service {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding-right: 14px;
}
.shop-component-service {
    flex-grow: 1.2;
    flex-direction: row;
    align-items: center;
}
.shop-component-repair-details {
    flex-grow: 1;
    min-width: 0;
}
.employee-portrait.shop-repair-portrait {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    border-radius: 23px;
}
.shop-car-choice .shop-car-row {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.shop-car-choice .shop-car-row.shop-wear-blocked, .shop-component-row.shop-wear-blocked {
    border-width: 2px;
    border-color: #ef5b57;
}
.shop-component-caption, .shop-component-mechanic {
    white-space: normal;
    font-size: 13px;
    margin-bottom: 4px;
}
.shop-component-mechanic {
    -unity-font-style: bold;
}
.shop-component-actions {
    width: 108px;
    flex-shrink: 0;
    justify-content: center;
}
.shop-component-action-line {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
    min-height: 28px;
}
.game-neutral .shop-component-action-button {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.shop-component-action-icon {
    width: 16px;
    height: 16px;
}
.shop-component-action-cost {
    margin-left: 7px;
    font-size: 13px;
}
.shop-component-level, .shop-component-meter {
    height: 9px;
}
.shop-component-level {
    flex-direction: row;
}
.shop-component-segment, .shop-component-meter {
    background-color: #394754;
    border-radius: 2px;
}
.shop-component-segment {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 3px;
}
.shop-component-segment-filled {
    background-color: #69b8e4;
}
.shop-component-wear, .shop-component-progress {
    height: 100%;
    border-radius: 2px;
}
.shop-component-wear {
    background-color: #edac59;
}
.shop-component-progress {
    background-color: #67c8a0;
}
.shop-component-meter.shop-component-repair-late {
    background-color: #784522;
}
.shop-component-repair-late .shop-component-progress {
    background-color: #ff9a41;
}
.garage-shop-background .team-header-row,
.garage-shop-background .garage-footer,
.garage-schedule-background .team-header-row,
.garage-schedule-background .garage-footer,
.garage-home-background .team-header-row,
.garage-home-background .garage-footer,
.garage-finances-background .team-header-row,
.garage-finances-background .garage-footer,
.garage-cars-background .team-header-row,
.garage-cars-background .garage-footer {
    background-color: rgba(16, 21, 30, 0.88);
}
.garage-schedule-background .schedule-page {
    background-color: rgba(16, 21, 30, 0.57);
}
.garage-screen.garage-schedule-background .schedule-page .garage-detail {
    color: #ffffff;
}
.garage-screen.garage-home-background #homePage .garage-entry {
    align-self: flex-start;
    max-width: 100%;
    background-color: rgba(16, 21, 30, 0.82);
}
.garage-screen.garage-home-background #homePage .garage-detail {
    color: #ffffff;
}
.garage-page {
    padding: 22px 12px;
}
.garage-page.event-setup-page {
    padding: 4px 12px;
}
.garage-page-title {
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}
.garage-screen .garage-entry {
    background-color: var(--game-surface);
}
.garage-screen .garage-detail {
    color: var(--game-text);
}
.garage-track-button {
    align-self: flex-start;
    margin-top: 12px;
}
.garage-footer {
    border-top-color: var(--game-divider);
    height: auto;
    padding-top: 10px;
}
.garage-footer .nav-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
    padding-left: 1px;
    padding-right: 1px;
}
.event-session-control {
    position: relative;
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
}
.garage-footer .event-session-control .event-next-session {
    margin: 0;
}
.garage-footer .event-session-control .event-session-options {
    flex-grow: 0;
    flex-basis: 27px;
    margin: 0;
}
.garage-footer .event-session-control .event-simulate-session {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    margin: 0;
}
.event-overview {
    flex-direction: row;
}
.event-detail-panel {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    min-width: 0;
    margin: 0 8px 10px;
    padding: 8px 10px;
    background-color: var(--game-surface);
}
.event-detail-panel .garage-detail {
    white-space: normal;
}
.setup-editor {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    padding: 0 10px;
}
.setup-board {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 1;
    margin: 4px 0;
}
.setup-side, .setup-center {
    flex-basis: 0;
    min-width: 0;
    flex-grow: 1;
    margin: 0 6px;
}
.setup-side {
    justify-content: space-between;
    max-width: 300px;
    padding-top: 26px;
}
.setup-center {
    max-width: 360px;
}
.setup-corner {
    flex-shrink: 0;
    padding: 6px;
    background-color: var(--game-surface);
    margin-bottom: 6px;
}
.setup-field {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    flex-shrink: 0;
}
.setup-part-row {
    flex-direction: row;
    align-items: center;
}
.setup-part-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 7px;
}
.game-neutral .setup-navigation-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.setup-navigation-icon .setup-part-icon {
    margin: 0;
}
.garage-open-setup {
    position: absolute;
    right: 8px;
    top: 28px;
}
.setup-part-controls {
    flex-grow: 1;
    min-width: 0;
}
.setup-field > .unity-slider {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 24px;
}
.setup-field .unity-base-field__label {
    min-width: 94px;
    flex-basis: 0;
    white-space: nowrap;
}
.setup-field .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
}
.setup-slider-value {
    width: 38px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.setup-overhead-car {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 224px;
    flex-shrink: 0;
    margin-top: 6px;
}
.setup-actions {
    align-self: flex-end;
    margin: 0 0 8px 12px;
}
.setup-footer {
    flex-direction: row;
    flex-wrap: wrap;
}
.setup-summary {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.setup-current-name {
    -unity-font-style: bold;
}
.setup-notes {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 1;
    flex-basis: 240px;
    min-width: 0;
    margin: 2px 0 8px;
}
.setup-notes .unity-base-field__input {
    height: 48px;
    min-width: 0;
    white-space: normal;
}
.setup-notes .unity-text-element {
    white-space: normal;
}
.setup-preset-list {
    max-height: 150px;
    margin: 8px 0;
}
.setup-preset-list .nav-button {
    margin: 2px 0;
    white-space: normal;
}
.event-track-outline {
    height: 140px;
    margin: 6px 0;
    color: var(--game-text);
}
.event-tire-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.event-tire-row > .garage-detail {
    width: 75px;
}
.event-tire-row > .unity-progress-bar {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}
.required-email-tooltip {
    display: none;
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: 6px;
    padding: 6px 9px;
    background-color: var(--game-surface);
    color: var(--game-text);
    border-width: 1px;
    border-color: #e55353;
    white-space: nowrap;
}

.title-screen {
    --title-accent: #009bdd;
    --title-accent-hover: #55c4ef;
}
.title-screen .brand,
.title-screen .eyebrow,
.title-screen .accent {
    color: var(--title-accent);
}
.title-screen .card {
    border-left-color: var(--title-accent);
}
.title-actions .action {
    flex-shrink: 0;
    margin: 0 10px 10px 0;
}
.title-actions .title-primary {
    background-color: var(--title-accent);
    border-color: var(--title-accent);
}
.title-actions .title-primary:hover,
.title-actions .title-primary:focus {
    background-color: var(--title-accent-hover);
    border-color: #ffffff;
}

.schedule-race {
    padding: 7px 0;
    border-bottom-width: 1px;
    border-bottom-color: #454545;
}
.schedule-race-completed {
    opacity: 0.5;
}

.schedule-page {
    flex-grow: 1;
    min-height: 0;
    padding-top: 12px;
    padding-bottom: 12px;
}
.schedule-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.schedule-standings, .schedule-events, .schedule-details {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
.schedule-events {
    margin: 0 16px;
}
.schedule-heading {
    flex-shrink: 0;
    -unity-font-style: bold;
}
.schedule-list {
    flex-grow: 1;
    min-height: 0;
}
.schedule-status {
    white-space: normal;
    flex-shrink: 0;
}
.schedule-track-outline {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 36px;
    max-height: 220px;
    margin: 8px 0;
}
.schedule-event-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: auto;
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: flex-end;
}
#simulateEventButton {
    margin-right: 6px;
}
.schedule-event-actions .nav-button {
    margin: 0;
}
.schedule-choice {
    margin: 2px 0;
    white-space: normal;
    -unity-text-align: middle-left;
}

.session-speed {
    align-self: center;
    min-width: 105px;
    margin-right: 12px;
}
.session-speed .unity-base-field__label {
    min-width: 0;
    color: #f5f5f5;
}

.results-grid {
    min-width: 0;
    margin-top: 12px;
}
.results-grid-row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--game-divider);
}
.results-grid-header {
    -unity-font-style: bold;
}
.results-grid-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 5px 6px;
    white-space: normal;
}
.results-grid-name {
    flex-grow: 1.65;
}

.track-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.track-timing {
    width: 25%;
    min-width: 200px;
    max-width: 310px;
    flex-shrink: 0;
    margin-left: 12px;
    margin-bottom: 12px;
    background-color: #1c2633;
}
.timing-rows {
    flex-grow: 1;
    min-height: 0;
}
.timing-row {
    flex-direction: row;
    padding: 5px 6px;
    border-bottom-width: 1px;
    border-bottom-color: #394350;
}
.timing-header {
    -unity-font-style: bold;
}
.timing-car {
    width: 18%;
}
.timing-driver {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}
.timing-row > Label {
    font-size: 12px;
    white-space: nowrap;
}
.timing-speed {
    width: 43px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.timing-lap {
    width: 32%;
    -unity-text-align: middle-right;
}

.timing-position {
    width: 15%;
}


.track-ratings {
    flex-direction: row;
    margin: 8px 0;
}
.rating-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
}
.rating-well {
    height: 48px;
    width: 56%;
    align-self: center;
    justify-content: flex-end;
    background-color: var(--game-surface);
}
.rating-fill {
    background-color: #009bdd;
}
.rating-label {
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.team-results-event-picker .unity-base-popup-field__input {
    background-color: #e4e8ee;
}
.team-results-event-picker .unity-base-popup-field__text {
    color: #171c23;
}
.team-results-event-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #171c23;
}

.standings-row {
    border-left-width: 3px;
    border-left-color: transparent;
}
.standings-player {
    border-left-color: #009bdd;
    -unity-font-style: bold;
}
.standings-position, .standings-car-number, .standings-points {
    flex-grow: 0;
    flex-basis: 54px;
    -unity-text-align: middle-center;
}

.cars-roster {
    min-width: 0;
}
.car-tabs .unity-scroll-view__content-container {
    flex-direction: row;
}
.game-neutral .car-panel {
    width: 310px;
    flex-shrink: 0;
    padding: 10px;
    margin: 4px 10px 4px 0;
    background-color: var(--game-surface);
}
.car-panel-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 8px;
}
.car-card-image {
    width: 100%;
    height: 145px;
}
.car-card-title, .car-card-specs {
    -unity-text-align: middle-center;
}
.car-card-title {
    -unity-font-style: bold;
}
.car-card-specs {
    margin-bottom: 8px;
}
.car-card-rating-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    font-size: 12px;
}
.car-card-component {
    width: 87px;
    flex-shrink: 0;
}
.car-card-rating-heading, .car-card-metric {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 6px;
}
.car-card-rating-heading {
    -unity-font-style: bold;
}
.car-card-metric {
    flex-direction: row;
    align-items: center;
}
.car-card-value {
    width: 34px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.game-neutral .car-card-action {
    width: 34px;
    min-width: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.car-card-action-icon {
    width: 18px;
    height: 18px;
}

.car-market-page {
    display: none;
    flex-grow: 1;
    min-height: 0;
}
.car-market-new {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 8px 0 16px;
}
.car-market-new-option {
    width: 240px;
    margin-left: 12px;
}
.car-market-new .nav-button {
    margin-left: 12px;
}
.car-market-back {
    align-self: flex-end;
    margin-top: 8px;
}
.car-market-action {
    flex-grow: 0;
    flex-basis: 88px;
    min-width: 0;
}

.employee-dismissal-prompt {
    display: none;
    margin: 8px 0;
    padding: 8px;
    background-color: var(--game-surface);
}

.employees-page {
    flex-grow: 1;
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}
.employee-roster {
    flex-grow: 1;
    min-height: 0;
}
.employee-work-list {
    flex-grow: 1;
    min-height: 0;
}
.employee-work-row {
    flex-direction: row;
    align-items: center;
    min-height: 67px;
    padding: 5px 10px;
    margin-bottom: 5px;
    background-color: #17232e;
    color: #eef5f8;
    border-left-width: 3px;
    border-left-color: #67c8a0;
}
.employee-work-row.employee-work-late {
    background-color: #3e271b;
    border-left-color: #ff9a41;
}
.employee-work-progress {
    flex-grow: 1;
    min-width: 0;
}
.game-neutral .employee-work-open-shop {
    width: 32px;
    min-width: 32px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
}
.employee-work-chassis {
    width: 118px;
    -unity-text-align: middle-center;
}
.employee-work-car {
    width: 112px;
    height: 59px;
}
.employee-work-mechanic {
    width: 210px;
    flex-direction: row;
    align-items: center;
    padding-right: 12px;
}
.employee-work-mechanic .shop-repair-portrait {
    margin: 0 8px 0 0;
}
.employee-work-details {
    flex-grow: 1;
    min-width: 0;
}
.employee-work-name, .employee-work-role {
    white-space: normal;
    -unity-text-align: middle-left;
}
.employee-work-role {
    font-size: 12px;
    opacity: 0.8;
}
.employee-roster .unity-scroll-view__content-container {
    flex-direction: row;
}
.game-neutral .employee-card {
    width: 240px;
    flex-shrink: 0;
    margin: 8px 8px 8px 0;
    padding: 8px;
    background-color: var(--game-surface);
}
.employee-card-identity {
    white-space: normal;
    -unity-text-align: middle-center;
}
.employee-card-skills {
    margin: 8px 0;
}
.employee-skill-row {
    flex-direction: row;
    align-items: center;
    min-height: 21px;
    font-size: 12px;
}
.employee-skill-name {
    width: 96px;
    flex-shrink: 0;
}
.employee-morale-divider {
    height: 1px;
    margin: 4px 0;
    background-color: var(--game-divider);
    opacity: 0.6;
}
.employee-skill-track {
    flex-grow: 1;
    min-width: 0;
    height: 8px;
    border-radius: 2px;
    background-color: #394754;
    overflow: hidden;
}
.employee-skill-fill {
    height: 100%;
    border-radius: 2px;
}
.employee-skill-value {
    width: 44px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.staff-card-actions {
    margin-top: auto;
    padding-top: 6px;
    align-items: flex-end;
}
.game-neutral .staff-card-fire-button {
    min-height: 22px;
    padding: 2px 8px;
    font-size: 12px;
}
.staff-card-fire-button:disabled {
    opacity: 0.5;
}
.employee-role-actions {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
}
.employee-role-actions .unity-base-field {
    width: 280px;
    margin-right: 8px;
}

#financesPage {
    padding-top: 10px;
    padding-bottom: 8px;
}
#financeBreakdown {
    margin-top: 4px;
}
.garage-finances-background #financeBreakdown {
    background-color: rgba(16, 21, 30, 0.76);
    color: #ffffff;
}
.garage-screen.garage-finances-background #financeBreakdown > .garage-detail {
    color: #ffffff;
}
#financeBreakdown .results-grid-cell {
    padding-top: 2px;
    padding-bottom: 2px;
}
.finance-summary {
    flex-direction: row;
}
.finance-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 4px 9px;
    min-width: 0;
    align-items: stretch;
}
.finance-card > Label {
    margin: 0;
    -unity-text-align: middle-left;
}
.finance-card > .garage-detail {
    font-size: 13px;
}
.finance-total {
    font-size: 19px;
    -unity-font-style: bold;
}
.finance-description {
    flex-grow: 2;
    -unity-text-align: middle-left;
}
#financeBreakdown .finance-group-toggle {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin: 0;
    padding: 0;
    height: auto;
    min-height: 23px;
    border-left-width: 0;
    border-right-width: 0;
}
.finance-number {
    -unity-text-align: middle-right;
}
.finance-positive {
    color: #91cf98;
}
.finance-negative {
    color: #f58a86;
}

.employee-portrait {
    width: 88px;
    height: 88px;
    align-self: center;
    margin-bottom: 4px;
    border-radius: 44px;
    overflow: hidden;
}
.game-neutral .employee-card .garage-detail {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
}

.recruitment-actions {
    margin-top: auto;
    flex-shrink: 0;
}
.recruitment-filter {
    max-width: 360px;
    margin-bottom: 8px;
}
.recruitment-row {
    align-items: center;
}
.recruitment-photo-cell {
    width: 56px;
    flex-shrink: 0;
    padding: 3px 4px;
}
.recruitment-portrait {
    width: 48px;
    height: 48px;
}
.recruitment-candidate {
    flex-grow: 1.6;
}
.recruitment-skills {
    flex-grow: 2;
}
.recruitment-action {
    width: 72px;
    flex-shrink: 0;
}

.team-calendar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
}
.team-date-panel {
    min-width: 88px;
    padding: 3px 6px;
    background-color: #236078;
}
.team-date-label {
    margin: 0;
    padding: 0;
    color: #f5f7fa;
    font-size: 12px;
    -unity-text-align: middle-center;
}
.team-calendar .nav-button {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 72px;
    margin-left: 4px;
}

.skip-race-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}
.skip-race-dialog {
    width: 440px;
    max-width: 90%;
    padding: 18px;
}
.skip-race-dialog .actions {
    margin-top: 12px;
    justify-content: flex-end;
}

.header.team-header-row {
    height: auto;
    min-height: 62px;
    padding-top: 4px;
    padding-bottom: 6px;
}

.team-header-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.team-header {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#teamNextRace {
    white-space: normal;
    text-overflow: clip;
}

.car-tab-image {
    width: 160px;
    height: 90px;
    align-self: center;
    margin-bottom: 4px;
}

.car-options-dialog {
    width: 520px;
    max-height: 85%;
}
.car-paint-preview {
    width: 100%;
    height: 195px;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.game-neutral .car-paint-color {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}
.car-paint-swatch {
    width: 34px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 10px;
    border-width: 1px;
    border-color: var(--game-divider);
}

.car-option-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    white-space: normal;
}

.car-option-image {
    width: 88px;
    height: 50px;
    margin-right: 10px;
    flex-shrink: 0;
}

#eventCarPicker {
    white-space: normal;
}

.car-option-row {
    background-color: rgb(40, 47, 56);
}

.car-option-row:hover {
    background-color: rgb(57, 66, 78);
}

.car-option-row Label {
    color: whitesmoke;
}

#trackScreen .track-heading {
    flex-shrink: 0;
}
.track-heading-labels {
    flex-shrink: 1;
    min-width: 0;
}
#trackScreen .track-heading > .actions {
    flex-shrink: 0;
}
.track-player-panel {
    flex-shrink: 0;
    padding: 6px;
    border-top-width: 1px;
    border-color: #394350;
    font-size: 12px;
}
.pit-readouts {
    flex-direction: row;
}
.pit-tires {
    width: 110px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
}
.pit-tire {
    width: 50%;
    align-items: center;
}
.pit-tire .unity-base-field__label,
.pit-levels .unity-base-field__label {
    min-width: 0;
}
.track-player-panel .unity-toggle__checkmark {
    scale: 0.5 0.5;
}
.pit-tire-bar, .pit-level-bar {
    background-color: #10151e;
    border-width: 1px;
    border-color: #64768b;
    overflow: hidden;
}
.pit-tire-bar {
    width: 14px;
    height: 35px;
    justify-content: flex-end;
}
.pit-level-bar {
    height: 9px;
    flex-direction: row;
}
.pit-meter-fill {
    background-color: #57d568;
}
.pit-damage-fill {
    background-color: #ef694d;
}
.pit-levels {
    flex-grow: 1;
    min-width: 0;
    padding-left: 4px;
}
.pit-levels > Label {
    white-space: normal;
}
.track-pit-status {
    min-height: 16px;
    white-space: normal;
}
.track-player-panel .action {
    align-self: stretch;
    min-width: 0;
    height: 28px;
    font-size: 13px;
}
#trackScreen .footer > .muted {
    min-width: 0;
    flex-shrink: 1;
    white-space: normal;
}
#trackScreen .footer > .brand {
    flex-shrink: 0;
    margin-left: 12px;
}

.practice-run-report {
    background-color: rgba(20, 28, 38, 0.96);
    border-radius: 6px;
    padding: 20px 24px;
    margin-top: 14px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.practice-run-group {
    flex-shrink: 0;
    padding-bottom: 22px;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: #526171;
}
.practice-run-report Label {
    color: #f4f7fb;
    font-size: 18px;
    white-space: normal;
    flex-shrink: 0;
    margin-top: 5px;
    margin-bottom: 7px;
}
.practice-run-report .practice-run-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}
.practice-run-tires {
    flex-direction: row;
    flex-wrap: nowrap;
    margin-top: 16px;
    margin-bottom: 18px;
    flex-shrink: 0;
}
.practice-run-tire {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}
.practice-run-tire .unity-progress-bar {
    height: 32px;
    min-height: 32px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.practice-run-report .unity-progress-bar__title {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #121a24;
}
.practice-run-laps {
    flex-shrink: 0;
    margin-top: 8px;
}
.practice-temperature-start {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: black;
}
.practice-run-laps > .unity-foldout__toggle {
    min-height: 32px;
    margin-bottom: 8px;
}
.practice-chart {
    background-color: #141c26;
    padding: 18px;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-basis: 0;
}
.practice-chart Label {
    color: #f4f7fb;
    font-size: 16px;
    margin-bottom: 8px;
}
.practice-chart Button {
    height: 38px;
    align-self: flex-start;
    margin-bottom: 14px;
}
.practice-chart Toggle {
    min-height: 25px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}
.practice-chart Toggle Label {
    font-size: 14px;
    margin-bottom: 0;
}
/* Vertical Garage sections must size to content, rather than sharing a zero basis. */
.event-garage-page {
    flex-shrink: 0;
}
.event-garage-page > .event-detail-panel {
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.event-garage-page > .event-overview {
    flex-shrink: 0;
    margin-bottom: 8px;
}
.event-garage-page .event-detail-panel > Label,
.event-garage-page > Label {
    flex-shrink: 0;
    min-height: 22px;
    margin-bottom: 6px;
}
.event-garage-page .event-tire-row {
    min-height: 30px;
    flex-shrink: 0;
}
.event-garage-page .event-tire-row > .garage-detail {
    width: 82px;
    min-width: 82px;
    flex-shrink: 0;
    white-space: nowrap;
}
.event-garage-page .garage-fuel-panel {
    min-height: 112px;
}
.event-garage-page #garageStartingFuel {
    flex-shrink: 0;
    height: 32px;
}
.event-garage-page #garageStartingFuel > .unity-base-field__label {
    min-width: 135px;
    flex-shrink: 0;
    color: #f4f7fb;
}
.event-garage-page #garageStartingFuel .unity-text-field__input {
    background-color: #263342;
    color: #ffffff;
    min-width: 52px;
}
.garage-simulation-controls {
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 42px;
    margin: 0 8px 18px;
}
.garage-simulation-controls > .unity-dropdown-field {
    width: 170px;
    min-width: 170px;
    height: 32px;
    margin-right: 12px;
}
.garage-simulation-controls .unity-base-field__label {
    min-width: 40px;
    width: 40px;
    flex-shrink: 0;
    color: #f4f7fb;
}
.garage-simulation-controls > Button {
    min-width: 130px;
    height: 32px;
    margin-top: 0;
    margin-bottom: 0;
}
.event-garage-page .shop-component-row {
    flex-shrink: 0;
}
.event-overview > .event-detail-panel {
    flex-grow: 1;
    flex-basis: 0;
}
.event-information-page,
.event-information-page > .event-overview {
    flex-shrink: 0;
}
.event-information-page > .event-overview {
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.event-information-page > .event-overview > .event-detail-panel {
    flex-basis: 320px;
}
.event-information-page .event-detail-panel > Label {
    flex-shrink: 0;
    min-height: 22px;
    white-space: normal;
    margin-bottom: 8px;
}
.event-information-page .schedule-race {
    min-height: 54px;
    padding-top: 8px;
    padding-bottom: 8px;
}
.event-information-page .event-track-outline {
    flex-shrink: 0;
}
.event-information-page .track-ratings {
    flex-wrap: wrap;
    flex-shrink: 0;
}
.event-information-page .rating-column {
    flex-basis: 76px;
    min-width: 76px;
    flex-shrink: 0;
    margin-bottom: 10px;
}
.event-information-page .rating-label,
.event-information-page .rating-well,
.event-information-page .shop-component-row {
    flex-shrink: 0;
}
.event-information-page .rating-label {
    min-height: 20px;
}