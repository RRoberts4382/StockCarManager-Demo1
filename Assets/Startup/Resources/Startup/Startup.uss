}
#employeesPage .employee-role-actions > .settings-button:hover,
#employeesPage .employee-role-actions > .settings-tab-current { background-color: #263e50; border-color: #55c4ef; }
.employee-card.team-home-panel {
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    border-radius: 10px;
    padding: 18px 10px 10px;
    margin: 14px 10px 6px 2px;
}
#employeesPage .team-home-heading { color: #009bdd; }
#employeesPage .employee-portrait { margin-top: 2px; }
