.screen {
    flex-grow: 1;
    padding: 26px 40px;
    background-color: #10151e;
    color: #f5f7fa;
}
.header, .footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 42px;
    border-color: #394350;
}
.header { border-bottom-width: 1px; }
.footer { border-top-width: 1px; }
.brand, .eyebrow, .muted {
    font-size: 14px;
    -unity-font-style: bold;
}
.brand, .accent, .eyebrow { color: #ffaf63; }
.muted { color: #aab7c8; }
.main {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}
.card {
    width: 100%;
    max-width: 740px;
    padding: 26px 34px;
    background-color: #1c2633;
    border-left-width: 5px;
    border-left-color: #ffaf63;
}
.eyebrow { margin-bottom: 14px; }
.title {
    font-size: 54px;
    -unity-font-style: bold;
    margin: 0;
}
.description {
    color: #c9d3e0;
    font-size: 19px;
    white-space: normal;
    margin-top: 14px;
    margin-bottom: 19px;
}
.action {
    align-self: flex-start;
    min-width: 170px;
    height: 44px;
    margin: 0;
    color: #141a22;
    background-color: #ffaf63;
    border-color: #ffaf63;
    font-size: 17px;
    -unity-font-style: bold;
}
.action:hover, .action:focus {
    background-color: #ffd2a7;
    border-color: #ffffff;
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
}
.quit-action {
    min-width: 90px;
    margin-left: 12px;
    color: #f5f7fa;
    background-color: #263342;
    border-color: #64768b;
}
.quit-action:hover, .quit-action:focus {
    background-color: #394a60;
    border-color: #ffffff;
}

.garage-entry {
    padding: 12px 16px;
    margin-bottom: 18px;
    background-color: #10151e;
}
.garage-detail {
    margin: 2px 0;
    color: #c9d3e0;
    font-size: 16px;
    white-space: normal;
}

#trackScreen {
    padding: 0;
    overflow: hidden;
}
.race-viewport {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: #192b2b;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.track-header.header {
    height: auto;
    min-height: 54px;
    padding: 6px 12px;
    background-color: rgba(16, 21, 30, 0.9);
}
.track-header-left, .track-header-right {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.track-header-right {
    justify-content: flex-end;
}
.track-playback {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 10px;
}
.track-playback > .track-header-icon {
    margin: 0;
    font-size: 19px;
}
.track-playback > .playback-speed-button {
    width: 48px;
    font-size: 14px;
    -unity-text-align: middle-right;
}
.track-playback > .playback-play-button {
    width: 24px;
    padding-left: 2px;
    -unity-text-align: middle-left;
}
.track-heading-labels {
    flex-shrink: 1;
    min-width: 0;
}
.track-name {
    font-size: 24px;
}
.track-heading-labels > Label,
.track-session > Label {
    white-space: normal;
}
.track-session {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 16px;
    margin-right: auto;
}
.track-header-icon {
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 32px;
    margin: 0 0 0 8px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: #ffbb79;
    font-size: 23px;
}
.track-header-icon:hover, .track-header-icon:focus, .track-header-icon:active {
    background-color: transparent;
    color: #fff4e8;
}
.track-header-icon:disabled {
    opacity: 0.5;
}
.track-icon-art {
    width: 22px;
    height: 22px;
}
.track-footer-center {
    align-items: center;
}
.track-readouts {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.track-readouts > Label {
    margin: 0 6px;
}
.track-footer.footer {
    height: 54px;
    padding: 0 12px;
    background-color: rgba(16, 21, 30, 0.9);
}
.track-footer-driving, .track-footer-pit {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.driving-meter {
    align-items: center;
    flex-shrink: 0;
    margin-right: 3px;
}
.driving-meter-bar {
    width: 12px;
    height: 30px;
    justify-content: flex-end;
    overflow: hidden;
    background-color: #253448;
    border-width: 1px;
    border-color: #64768b;
}
.driving-meter-fill {
    height: 0;
}
.throttle-fill {
    background-color: #57d568;
}
.brake-fill {
    background-color: #ef694d;
}
.fuel-fill {
    background-color: #ffcf55;
}
.track-footer-mph {
    min-width: 86px;
    margin-left: 4px;
    font-size: 16px;
    -unity-font-style: bold;
}
.track-footer-engine {
    margin-left: 8px;
    color: #c9d3e0;
    font-size: 13px;
}
.track-footer-pit {
    justify-content: flex-end;
}
.track-footer-pit > Label {
    margin-right: 8px;
}
#trackCameraAngle {
    margin-right: 0;
}
#cycleTrackCameraButton {
    margin: 0 8px 0 0;
}
.track-footer-pit > .pit-settings-button {
    margin: 0;
}
.track-icon-tooltip {
    display: none;
    position: absolute;
    margin: 0;
    padding: 5px 8px;
    border-radius: 4px;
    background-color: #10151e;
    color: #f5f7fa;
    font-size: 13px;
    white-space: normal;
}
.setup-preset-name .unity-base-field__label,
.setup-notes .unity-base-field__label {
    color: #e3e9f2;
}
.setup-preset-name .unity-base-text-field__input,
.setup-notes .unity-base-text-field__input {
    background-color: #202b39;
    border-color: #69798c;
    color: #f5f7fa;
    --unity-cursor-color: #ffffff;
    --unity-selection-color: #315b87;
}
.setup-preset-name .unity-base-text-field__input:focus,
.setup-notes .unity-base-text-field__input:focus {
    border-color: #ffaf63;
}
.setup-preset-name .unity-base-text-field__input .unity-text-element,
.setup-notes .unity-base-text-field__input .unity-text-element {
    color: #f5f7fa;
    --unity-cursor-color: #ffffff;
    --unity-selection-color: #315b87;
}

/* Shared neutral palette. Apply game-neutral to a screen to use it. */
.game-neutral {
    --game-background: #151515;
    --game-surface: #222222;
    --game-button: #454545;
    --game-button-hover: #565656;
    --game-button-selected: #626262;
    --game-text: #f5f5f5;
    --game-divider: #b6b6b6;
    background-color: var(--game-background);
    color: var(--game-text);
}
.game-neutral .nav-button {
    color: var(--game-text);
    background-color: var(--game-button);
    border-color: var(--game-button);
    min-height: 34px;
    padding: 4px 8px;
}
.game-neutral .nav-button:hover, .game-neutral .nav-button:focus {
    background-color: var(--game-button-hover);
    border-color: var(--game-divider);
}
.game-neutral .nav-button-selected {
    background-color: var(--game-button-selected);
    border-bottom-color: var(--game-divider);
}
.garage-heading {
    color: #009bdd;
    font-size: 22px;
    -unity-font-style: bold;
}
.garage-body {
    flex-grow: 1;
    min-height: 0;
}
.mail-page, .mail-email-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.mail-email, .mail-social, .mail-inbox, .mail-reader {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
.mail-email, .mail-reader {
    flex-grow: 2;
}
.mail-social, .mail-inbox {
    flex-grow: 1;
}
.mail-social {
    margin-left: 18px;
    padding-left: 14px;
    border-left-width: 1px;
    border-left-color: var(--game-divider);
}
.mail-inbox {
    margin-right: 10px;
}
.mail-reader {
    padding: 14px;
    background-color: var(--game-surface);
    border-top-width: 2px;
    border-top-color: #4597b4;
}
.mail-scroll {
    flex-grow: 1;
    min-height: 0;
}
.mail-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}
.mail-subheading, .mail-subject {
    -unity-font-style: bold;
    white-space: normal;
}
.mail-inbox-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}
.mail-inbox-header > .mail-subheading {
    flex-grow: 1;
    align-self: center;
}
.mail-inbox-row {
    position: relative;
    flex-shrink: 0;
    margin-bottom: 5px;
}
.mail-page .mail-message-row {
    flex-grow: 1;
    min-width: 0;
    height: auto;
    min-height: 54px;
    margin: 0;
    padding: 6px 38px 6px 8px;
    align-items: stretch;
    -unity-text-align: middle-left;
}
.game-neutral .mail-page .mail-message-row.mail-unread {
    border-left-width: 3px;
    border-left-color: #36aee4;
    background-color: var(--game-button-selected);
}
.game-neutral .mail-page .mail-message-row.mail-scenario {
    border-width: 1px;
    border-color: #e55353;
}
.mail-page .mail-scenario-alert {
    color: #e55353;
    font-size: 18px;
    -unity-font-style: bold;
    align-self: center;
}
.mail-page .mail-scenario-choice {
    align-self: flex-start;
    margin: 8px 0 0;
}
.mail-sender, .mail-meta {
    font-size: 12px;
    opacity: 0.78;
    white-space: normal;
}
.mail-message-title {
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}
.mail-broadcast-logo {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
    margin-bottom: 10px;
    border-radius: 6px;
    overflow: hidden;
}
.mail-copy {
    white-space: normal;
    margin-top: 8px;
}
.mail-post {
    padding: 8px 10px;
    margin-bottom: 8px;
    background-color: var(--game-surface);
    border-left-width: 3px;
    border-left-color: #758b9b;
}
.mail-post-header {
    flex-direction: row;
    align-items: flex-start;
}
.mail-post-header > .mail-title {
    flex-grow: 1;
}
.mail-post-author {
    flex-grow: 1;
    min-width: 0;
}
.mail-post-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 18px;
    background-size: cover;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}
.mail-avatar-initials {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}
.mail-page .mail-post-delete {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 0 0 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.mail-trash-icon {
    width: 16px;
    height: 16px;
}
.mail-page .mail-inbox-delete {
    position: absolute;
    top: 6px;
    right: 6px;
    margin: 0;
}
.victory-results-background {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
}
.victory-results-background .garage-page {
    background-color: rgba(16, 21, 30, 0.63);
}
.victory-results-background .garage-page-title,
.victory-results-background .unity-base-field__label,
.garage-screen .victory-results-background .results-grid-cell {
    color: #ffffff;
}
.garage-shop-background, .garage-schedule-background, .garage-home-background, .garage-finances-background, .garage-cars-background {
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
}
.garage-shop-background {
    background-image: url("RaceTeamShop.png");
}
.shop-car-picker {
    position: absolute;
    top: 22px;
    left: 12px;
    width: 350px;
    max-width: 100%;
}
.game-neutral .shop-car-toggle, .game-neutral .shop-car-choice {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 3px 6px;
    min-height: 0;
}
.shop-car-choices {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 2px;
    max-height: 420px;
    background-color: var(--game-surface);
}
.shop-car-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}
.shop-car-thumbnail {
    width: 90px;
    height: 50px;
    flex-shrink: 0;
}
.shop-car-chassis {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-center;
}
.shop-car-specs {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.shop-car-spec {
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}
.shop-car-caret {
    flex-shrink: 0;
    padding-left: 6px;
}
.shop-car-components {
    margin-top: 70px;
    padding: 3px 12px;
    background-color: rgba(15, 22, 31, 0.86);
    color: #eef5f8;
}
.shop-component-row {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    padding: 3px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(190, 222, 239, 0.22);
}
.shop-component-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 16px;
}
.shop-component-metric, .shop-component-service {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding-right: 14px;
}
.shop-component-service {
    flex-grow: 1.2;
    flex-direction: row;
    align-items: center;
}
.shop-component-repair-details {
    flex-grow: 1;
    min-width: 0;
}
.employee-portrait.shop-repair-portrait {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    border-radius: 23px;
}
.shop-car-choice .shop-car-row {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.shop-car-choice .shop-car-row.shop-wear-blocked, .shop-component-row.shop-wear-blocked {
    border-width: 2px;
    border-color: #ef5b57;
}
.shop-component-caption, .shop-component-mechanic {
    white-space: normal;
    font-size: 13px;
    margin-bottom: 4px;
}
.shop-component-mechanic {
    -unity-font-style: bold;
}
.shop-component-actions {
    width: 108px;
    flex-shrink: 0;
    justify-content: center;
}
.shop-component-action-line {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
    min-height: 28px;
}
.game-neutral .shop-component-action-button {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.shop-component-action-icon {
    width: 16px;
    height: 16px;
}
.shop-component-action-cost {
    margin-left: 7px;
    font-size: 13px;
}
.shop-component-level, .shop-component-meter {
    height: 9px;
}
.shop-component-level {
    flex-direction: row;
}
.shop-component-segment, .shop-component-meter {
    background-color: #394754;
    border-radius: 2px;
}
.shop-component-segment {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 3px;
}
.shop-component-segment-filled {
    background-color: #69b8e4;
}
.shop-component-wear, .shop-component-progress {
    height: 100%;
    border-radius: 2px;
}
.shop-component-wear {
    background-color: #edac59;
}
.shop-component-progress {
    background-color: #67c8a0;
}
.shop-component-meter.shop-component-repair-late {
    background-color: #784522;
}
.shop-component-repair-late .shop-component-progress {
    background-color: #ff9a41;
}
.garage-shop-background .team-header-row,
.garage-shop-background .garage-footer,
.garage-schedule-background .team-header-row,
.garage-schedule-background .garage-footer,
.garage-home-background .team-header-row,
.garage-home-background .garage-footer,
.garage-finances-background .team-header-row,
.garage-finances-background .garage-footer,
.garage-cars-background .team-header-row,
.garage-cars-background .garage-footer {
    background-color: rgba(16, 21, 30, 0.88);
}
.garage-schedule-background .schedule-page {
    background-color: rgba(16, 21, 30, 0.57);
}
.garage-screen.garage-schedule-background .schedule-page .garage-detail {
    color: #ffffff;
}
.garage-screen.garage-home-background #homePage .garage-entry {
    align-self: flex-start;
    max-width: 100%;
    background-color: rgba(16, 21, 30, 0.82);
}
.garage-screen.garage-home-background #homePage .garage-detail {
    color: #ffffff;
}
.garage-page {
    padding: 22px 12px;
}
.garage-page.event-setup-page {
    padding: 4px 12px;
}
.garage-page-title {
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}
.garage-screen .garage-entry {
    background-color: var(--game-surface);
}
.garage-screen .garage-detail {
    color: var(--game-text);
}
.garage-track-button {
    align-self: flex-start;
    margin-top: 12px;
}
.garage-footer {
    border-top-color: var(--game-divider);
    height: auto;
    padding-top: 10px;
    padding-bottom: 10px;
}
.garage-footer .nav-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
    padding-left: 1px;
    padding-right: 1px;
}
.event-session-control {
    position: relative;
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
}
.garage-footer .event-session-control .event-next-session {
    margin: 0;
}
.garage-footer .event-session-control .event-session-options {
    flex-grow: 0;
    flex-basis: 27px;
    margin: 0;
}
.garage-footer .event-session-control .event-simulate-session {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    margin: 0;
}
.event-overview {
    flex-direction: row;
}
.event-detail-panel {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    min-width: 0;
    margin: 0 8px 10px;
    padding: 8px 10px;
    background-color: var(--game-surface);
}
.event-detail-panel .garage-detail {
    white-space: normal;
}
.setup-editor {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    padding: 0 10px;
}
.setup-board {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 1;
    margin: 4px 0;
}
.setup-side, .setup-center {
    flex-basis: 0;
    min-width: 0;
    flex-grow: 1;
    margin: 0 6px;
}
.setup-side {
    justify-content: space-between;
    max-width: 300px;
    padding-top: 26px;
}
.setup-center {
    max-width: 360px;
}
.setup-corner {
    flex-shrink: 0;
    padding: 6px;
    background-color: var(--game-surface);
    margin-bottom: 6px;
}
.setup-field {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    flex-shrink: 0;
}
.setup-part-row {
    flex-direction: row;
    align-items: center;
}
.setup-part-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 7px;
}
.game-neutral .setup-navigation-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.setup-navigation-icon .setup-part-icon {
    margin: 0;
}
.garage-open-setup {
    position: absolute;
    right: 8px;
    top: 28px;
}
.setup-part-controls {
    flex-grow: 1;
    min-width: 0;
}
.setup-field > .unity-slider {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 24px;
}
.setup-field .unity-base-field__label {
    min-width: 94px;
    flex-basis: 0;
    white-space: nowrap;
}
.setup-field .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
}
.setup-slider-value {
    width: 38px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.setup-overhead-car {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 224px;
    flex-shrink: 0;
    margin-top: 6px;
}
.setup-actions {
    align-self: flex-end;
    margin: 0 0 8px 12px;
}
.setup-footer {
    flex-direction: row;
    flex-wrap: wrap;
}
.setup-summary {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.setup-current-name {
    -unity-font-style: bold;
}
.setup-notes {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 1;
    flex-basis: 240px;
    min-width: 0;
    margin: 2px 0 8px;
}
.setup-notes .unity-base-field__input {
    height: 48px;
    min-width: 0;
    white-space: normal;
}
.setup-notes .unity-text-element {
    white-space: normal;
}
.setup-preset-list {
    max-height: 150px;
    margin: 8px 0;
}
.setup-preset-list .nav-button {
    margin: 2px 0;
    white-space: normal;
}
.event-track-outline {
    height: 140px;
    margin: 6px 0;
    color: var(--game-text);
}
.event-tire-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.event-tire-row > .garage-detail {
    width: 75px;
}
.event-tire-row > .unity-progress-bar {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}
.required-email-tooltip {
    display: none;
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: 6px;
    padding: 6px 9px;
    background-color: var(--game-surface);
    color: var(--game-text);
    border-width: 1px;
    border-color: #e55353;
    white-space: nowrap;
}

.title-screen {
    --title-accent: #009bdd;
    --title-accent-hover: #55c4ef;
}
.title-screen .brand,
.title-screen .eyebrow,
.title-screen .accent {
    color: var(--title-accent);
}
.title-screen .card {
    border-left-color: var(--title-accent);
}
.title-actions .action {
    flex-shrink: 0;
    margin: 0 10px 10px 0;
}
.title-actions .title-primary {
    background-color: var(--title-accent);
    border-color: var(--title-accent);
}
.title-actions .title-primary:hover,
.title-actions .title-primary:focus {
    background-color: var(--title-accent-hover);
    border-color: #ffffff;
}

#titleScreen {
    overflow: hidden;
}
.title-background {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-image: url("StartupHoneycomb.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.title-background-shade {
    background-image: none;
    background-color: rgba(0, 0, 0, 0.5);
}
.title-card {
    align-items: center;
    max-width: 800px;
    background-color: rgba(16, 21, 30, 0.9);
}
.title-logo {
    background-image: url("../../StockCarManagerLogo.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    width: 296px;
    max-width: 100%;
    height: 266px;
    margin: 0;
}
.title-card .actions {
    justify-content: center;
}
.title-tagline {
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/StoryScript-Regular.ttf");
    -unity-font-style: normal;
    font-size: 28px;
    margin-top: 8px;
    margin-bottom: 16px;
}
.title-career-list {
    align-self: stretch;
    max-height: 360px;
    margin: 0 0 8px;
    padding: 4px;
    background-color: #10151e;
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 8px;
}
.title-career-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.title-career-load {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 77px;
    padding: 6px 10px;
}
.title-career-car {
    width: 112px;
    height: 63px;
    flex-shrink: 0;
    margin-right: 12px;
}
.title-career-details {
    flex-grow: 1;
    min-width: 0;
}
.title-career-name, .title-career-detail {
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.title-career-name {
    font-size: 16px;
    -unity-font-style: bold;
}
.title-career-detail {
    font-size: 13px;
    color: #d1dce7;
}
.title-career-delete {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: #ff8c8c;
    border-color: #ff8c8c;
}

.title-icon-row {
    margin-top: 5px;
}
.title-icon-button {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 46px;
    height: 42px;
    padding: 0;
    margin: 0 8px 4px 0;
    border-width: 1px;
    border-radius: 8px;
    background-color: #182432;
}
.title-icon-button:hover, .title-icon-button:focus {
    background-color: #26384d;
    border-color: #ffffff;
}
.title-practice-icon { color: #85dda0; border-color: #85dda0; }
.title-settings-icon { color: #c6a5ff; border-color: #c6a5ff; }
.title-quit-icon { color: #ff8c8c; border-color: #ff8c8c; }

.schedule-race {
    padding: 7px 0;
    border-bottom-width: 1px;
    border-bottom-color: #454545;
}
.schedule-race-completed {
    opacity: 0.5;
}

.schedule-page {
    flex-grow: 1;
    min-height: 0;
    padding-top: 12px;
    padding-bottom: 12px;
}
.schedule-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.schedule-standings, .schedule-events, .schedule-details {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
.schedule-events {
    margin: 0 16px;
}
.schedule-heading {
    flex-shrink: 0;
    -unity-font-style: bold;
}
.schedule-list {
    flex-grow: 1;
    min-height: 0;
}
.schedule-status {
    white-space: normal;
    flex-shrink: 0;
}
.schedule-track-outline {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 36px;
    max-height: 220px;
    margin: 8px 0;
}
.schedule-event-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: auto;
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: flex-end;
}
#simulateEventButton {
    margin-right: 6px;
}
.schedule-event-actions .nav-button {
    margin: 0;
}
.schedule-choice {
    margin: 2px 0;
    white-space: normal;
    -unity-text-align: middle-left;
}

.results-grid {
    min-width: 0;
    margin-top: 12px;
}
.results-grid-row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--game-divider);
}
.results-grid-header {
    -unity-font-style: bold;
}
.results-grid-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 5px 6px;
    white-space: normal;
}
.results-grid-name {
    flex-grow: 1.65;
}

.track-content {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
    min-height: 0;
    padding: 8px 12px 0;
}
.track-cockpit {
    display: none;
    position: absolute;
    top: 8px;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
}
.cockpit-steering-wheel {
    position: absolute;
    left: 54%;
    bottom: -67px;
    width: 174px;
    height: 174px;
    translate: -50% 0;
}
.tour-modified-cockpit .cockpit-steering-wheel {
    left: 57%;
}
.cockpit-mirror {
    width: 256px;
    max-width: 40%;
    height: 72px;
    flex-shrink: 0;
    overflow: hidden;
    border-width: 4px;
    border-radius: 12px;
    border-color: #13191f;
    background-color: #18242e;
}
.cockpit-mirror-image {
    flex-grow: 1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    scale: -1 1;
}
.cockpit-dashboard {
    align-self: flex-start;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    width: 53%;
    height: 142px;
    flex-shrink: 0;
    padding: 0 12px 5px;
    border-top-width: 3px;
    border-top-color: #555958;
    border-top-right-radius: 12px;
    border-bottom-width: 9px;
    border-bottom-color: #101113;
    background-color: #27292a;
}
.cockpit-switch-panel {
    width: 94px;
    height: 72px;
    margin-right: 8px;
    background-color: #191b1c;
    border-width: 1px;
    border-color: #4e504e;
    border-radius: 3px;
}
.cockpit-gauge {
    width: 66px;
    height: 66px;
    flex-shrink: 1;
    margin: 0 2px;
}
.cockpit-gauge-main {
    width: 106px;
    height: 106px;
}
.cockpit-gauge-needle {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}
.cockpit-gauge-labels {
    position: absolute;
    align-items: center;
    right: 0;
    bottom: 19%;
    left: 0;
}
.cockpit-gauge-labels > Label {
    margin: 0;
    color: #292b28;
    -unity-font-style: bold;
    white-space: nowrap;
}
.cockpit-gauge-name {
    font-size: 7px;
}
.cockpit-gauge-value {
    font-size: 9px;
}
.cockpit-gauge-main .cockpit-gauge-name {
    font-size: 9px;
}
.cockpit-gauge-main .cockpit-gauge-value {
    font-size: 15px;
}
.cockpit-gauge-dark .cockpit-gauge-labels > Label {
    color: #f0e8d5;
}
.tour-modified-cockpit .cockpit-dashboard {
    position: absolute;
    left: 23%;
    bottom: 1%;
    width: 34%;
    max-width: 370px;
    height: 18%;
    min-height: 65px;
    max-height: 102px;
    padding: 0 8px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: #4b4d4c;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #1d2022;
}
.tour-modified-cockpit .cockpit-switch-panel {
    width: 65px;
    height: 29px;
    margin-right: 4px;
    background-color: #262a2b;
    border-color: #555653;
}
.tour-modified-cockpit .cockpit-gauge {
    width: 53px;
    height: 64%;
}
.tour-modified-cockpit .cockpit-gauge-main {
    width: 88px;
    height: 94%;
}
.tour-modified-cockpit .cockpit-mirror {
    width: 196px;
    height: 54px;
    border-width: 3px;
    border-radius: 7px;
}
.in-car-view .track-standings {
    margin-bottom: 152px;
}
.track-standings {
    width: 248px;
    min-height: 0;
    flex-shrink: 0;
    margin-bottom: 10px;
}
.track-standings.standings-lap-speeds {
    width: 370px;
}
.track-standings.standings-collapsed {
    width: 31px;
}
.standings-collapsed .timing-header {
    justify-content: center;
    padding: 0;
    border-bottom-width: 0;
    border-radius: 3px;
    background-color: #10151e;
}
.standings-collapsed .timing-header > Label,
.standings-collapsed .timing-rows,
.standings-collapsed .standings-laps-toggle {
    display: none;
}
.standings-toggle {
    flex-shrink: 0;
    width: 19px;
    height: 17px;
    margin: 0;
    padding: 0;
    color: #141a22;
    background-color: #ffaf63;
    border-color: #ffaf63;
    font-size: 14px;
    -unity-font-style: bold;
}
.standings-laps-toggle {
    margin-left: 3px;
}
.standings-toggle:hover, .standings-toggle:focus {
    background-color: #ffd2a7;
    border-color: #ffffff;
}
.track-right-dock {
    position: absolute;
    right: 12px;
    bottom: 60px;
    width: 26%;
    min-width: 232px;
    max-width: 352px;
    max-height: 76%;
    justify-content: flex-end;
}
.track-map-widget {
    min-height: 0;
    flex-shrink: 1;
}
.track-map-widget.track-map-collapsed {
    align-self: flex-end;
    width: 31px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 3px;
    background-color: #10151e;
}
.track-map-collapsed .track-session-map {
    display: none;
}
.track-map-toggle {
    position: absolute;
    top: 3px;
    right: 6px;
}
.track-session-map {
    height: 194px;
    min-height: 80px;
    flex-shrink: 1;
    overflow: hidden;
    border-radius: 6px;
    background-color: rgba(16, 21, 30, 0.88);
}
.track-map-car {
    position: absolute;
    left: 0;
    top: 0;
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-radius: 8px;
    border-color: #d4dce3;
    background-color: #263342;
    color: #ffffff;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.track-map-car.track-map-player {
    border-color: #fff3df;
    background-color: #ffaf63;
    color: #141a22;
}
.track-pit-controls {
    display: none;
    flex-shrink: 0;
    margin-top: 6px;
    background-color: rgba(28, 38, 51, 0.98);
}
.track-pit-controls.pit-settings-open {
    display: flex;
}
.timing-rows {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(28, 38, 51, 0.94);
}
.timing-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    flex-shrink: 0;
    padding: 0 6px;
    border-bottom-width: 1px;
    border-bottom-color: #394350;
}
.timing-data-row {
    padding-right: 47px;
}
.timing-header {
    height: 24px;
    background-color: #253448;
    -unity-font-style: bold;
}
.timing-player {
    background-color: #2c5065;
    border-left-color: #73d5ff;
    border-left-width: 3px;
    padding-left: 3px;
    -unity-font-style: bold;
}
.timing-position, .timing-car {
    width: 29px;
    flex-shrink: 0;
}
.timing-driver {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}
.timing-driver-name {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}
.timing-row > Label, .timing-driver > Label {
    margin: 0;
    font-size: 12px;
    white-space: nowrap;
}
.timing-lap-mph {
    display: none;
    width: 61px;
    padding-right: 6px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.standings-lap-speeds .timing-lap-mph {
    display: flex;
}
.timing-status {
    width: 14px;
    margin-left: 4px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}
.timing-status-icon {
    width: 10px;
    height: 7px;
    border-width: 2px;
    border-color: #73d9a2;
    border-radius: 4px;
}
.timing-status-icon.timing-in-pits {
    width: 8px;
    height: 8px;
    border-width: 0;
    border-radius: 0;
    rotate: 45deg;
    background-color: #ffcf75;
}
.timing-status-icon.timing-off-track {
    height: 2px;
    border-width: 0;
    background-color: #a3adb9;
}

.track-ratings {
    flex-direction: row;
    margin: 8px 0;
}
.rating-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
}
.rating-well {
    height: 48px;
    width: 56%;
    align-self: center;
    justify-content: flex-end;
    background-color: var(--game-surface);
}
.rating-fill {
    background-color: #009bdd;
}
.rating-label {
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.team-results-event-picker .unity-base-popup-field__input {
    background-color: #e4e8ee;
}
.team-results-event-picker .unity-base-popup-field__text {
    color: #171c23;
}
.team-results-event-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #171c23;
}

.standings-row {
    border-left-width: 3px;
    border-left-color: transparent;
}
.standings-player {
    border-left-color: #009bdd;
    -unity-font-style: bold;
}
.standings-position, .standings-car-number, .standings-points {
    flex-grow: 0;
    flex-basis: 54px;
    -unity-text-align: middle-center;
}

.cars-roster {
    min-width: 0;
}
.car-tabs .unity-scroll-view__content-container {
    flex-direction: row;
}
.game-neutral .car-panel {
    width: 310px;
    flex-shrink: 0;
    padding: 10px;
    margin: 4px 10px 4px 0;
    background-color: var(--game-surface);
}
.car-panel-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 8px;
}
.car-card-image {
    width: 100%;
    height: 145px;
}
.car-card-title, .car-card-specs {
    -unity-text-align: middle-center;
}
.car-card-title {
    -unity-font-style: bold;
}
.car-card-specs {
    margin-bottom: 8px;
}
.car-card-rating-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    font-size: 12px;
}
.car-card-component {
    width: 87px;
    flex-shrink: 0;
}
.car-card-rating-heading, .car-card-metric {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 6px;
}
.car-card-rating-heading {
    -unity-font-style: bold;
}
.car-card-metric {
    flex-direction: row;
    align-items: center;
}
.car-card-value {
    width: 34px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.game-neutral .car-card-action {
    width: 34px;
    min-width: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.car-card-action-icon {
    width: 18px;
    height: 18px;
}

.car-market-page {
    display: none;
    flex-grow: 1;
    min-height: 0;
}
.car-market-new {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 8px 0 16px;
}
.car-market-new-option {
    width: 240px;
    margin-left: 12px;
}
.car-market-new .nav-button {
    margin-left: 12px;
}
.car-market-back {
    align-self: flex-end;
    margin-top: 8px;
}
.car-market-action {
    flex-grow: 0;
    flex-basis: 88px;
    min-width: 0;
}

.employee-dismissal-prompt {
    display: none;
    margin: 8px 0;
    padding: 8px;
    background-color: var(--game-surface);
}

.employees-page {
    flex-grow: 1;
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}
.employee-roster {
    flex-grow: 1;
    min-height: 0;
}
.employee-work-list {
    flex-grow: 1;
    min-height: 0;
}
.employee-work-row {
    flex-direction: row;
    align-items: center;
    min-height: 67px;
    padding: 5px 10px;
    margin-bottom: 5px;
    background-color: #17232e;
    color: #eef5f8;
    border-left-width: 3px;
    border-left-color: #67c8a0;
}
.employee-work-row.employee-work-late {
    background-color: #3e271b;
    border-left-color: #ff9a41;
}
.employee-work-progress {
    flex-grow: 1;
    min-width: 0;
}
.game-neutral .employee-work-open-shop {
    width: 32px;
    min-width: 32px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
}
.employee-work-chassis {
    width: 118px;
    -unity-text-align: middle-center;
}
.employee-work-car {
    width: 112px;
    height: 59px;
}
.employee-work-mechanic {
    width: 210px;
    flex-direction: row;
    align-items: center;
    padding-right: 12px;
}
.employee-work-mechanic .shop-repair-portrait {
    margin: 0 8px 0 0;
}
.employee-work-details {
    flex-grow: 1;
    min-width: 0;
}
.employee-work-name, .employee-work-role {
    white-space: normal;
    -unity-text-align: middle-left;
}
.employee-work-role {
    font-size: 12px;
    opacity: 0.8;
}
.employee-roster .unity-scroll-view__content-container {
    flex-direction: row;
}
.game-neutral .employee-card {
    width: 240px;
    flex-shrink: 0;
    margin: 8px 8px 8px 0;
    padding: 8px;
    background-color: var(--game-surface);
}
.employee-card-identity {
    white-space: normal;
    -unity-text-align: middle-center;
}
.employee-card-skills {
    margin: 8px 0;
}
.employee-skill-row {
    flex-direction: row;
    align-items: center;
    min-height: 21px;
    font-size: 12px;
}
.employee-skill-name {
    width: 96px;
    flex-shrink: 0;
}
.employee-morale-divider {
    height: 1px;
    margin: 4px 0;
    background-color: var(--game-divider);
    opacity: 0.6;
}
.employee-skill-track {
    flex-grow: 1;
    min-width: 0;
    height: 8px;
    border-radius: 2px;
    background-color: #394754;
    overflow: hidden;
}
.employee-skill-fill {
    height: 100%;
    border-radius: 2px;
}
.employee-skill-value {
    width: 44px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.staff-card-actions {
    margin-top: auto;
    padding-top: 6px;
    align-items: flex-end;
}
.game-neutral .staff-card-fire-button {
    min-height: 22px;
    padding: 2px 8px;
    font-size: 12px;
}
.staff-card-fire-button:disabled {
    opacity: 0.5;
}
.employee-role-actions {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
}
.employee-role-actions .unity-base-field {
    width: 280px;
    margin-right: 8px;
}

#financesPage {
    padding-top: 10px;
    padding-bottom: 8px;
}
#financeBreakdown {
    margin-top: 4px;
}
.garage-finances-background #financeBreakdown {
    background-color: rgba(16, 21, 30, 0.76);
    color: #ffffff;
}
.garage-screen.garage-finances-background #financeBreakdown > .garage-detail {
    color: #ffffff;
}
#financeBreakdown .results-grid-cell {
    padding-top: 2px;
    padding-bottom: 2px;
}
.finance-summary {
    flex-direction: row;
}
.finance-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 4px 9px;
    min-width: 0;
    align-items: stretch;
}
.finance-card > Label {
    margin: 0;
    -unity-text-align: middle-left;
}
.finance-card > .garage-detail {
    font-size: 13px;
}
.finance-total {
    font-size: 19px;
    -unity-font-style: bold;
}
.finance-description {
    flex-grow: 2;
    -unity-text-align: middle-left;
}
#financeBreakdown .finance-group-toggle {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin: 0;
    padding: 0;
    height: auto;
    min-height: 23px;
    border-left-width: 0;
    border-right-width: 0;
}
.finance-number {
    -unity-text-align: middle-right;
}
.finance-positive {
    color: #91cf98;
}
.finance-negative {
    color: #f58a86;
}

.employee-portrait {
    width: 88px;
    height: 88px;
    align-self: center;
    margin-bottom: 4px;
    border-radius: 44px;
    overflow: hidden;
}
.game-neutral .employee-card .garage-detail {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
}

.recruitment-actions {
    margin-top: auto;
    flex-shrink: 0;
}
.recruitment-filter {
    max-width: 360px;
    margin-bottom: 8px;
}
.recruitment-row {
    align-items: center;
}
.recruitment-photo-cell {
    width: 56px;
    flex-shrink: 0;
    padding: 3px 4px;
}
.recruitment-portrait {
    width: 48px;
    height: 48px;
}
.recruitment-candidate {
    flex-grow: 1.6;
}
.recruitment-skills {
    flex-grow: 2;
}
.recruitment-action {
    width: 72px;
    flex-shrink: 0;
}

.team-calendar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 0;
}
.team-date-panel {
    margin-left: 6px;
    margin-right: 6px;
    min-width: 88px;
    padding: 3px 6px;
    background-color: #236078;
}
.team-date-label {
    margin: 0;
    padding: 0;
    color: #f5f7fa;
    font-size: 12px;
    -unity-text-align: middle-center;
}
.team-calendar .nav-button {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 72px;
    margin-left: 4px;
}

.skip-race-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}
.skip-race-dialog {
    width: 440px;
    max-width: 90%;
    padding: 18px;
}
.skip-race-dialog .actions {
    margin-top: 12px;
    justify-content: flex-end;
}

.header.team-header-row {
    height: auto;
    min-height: 62px;
    padding-top: 4px;
    padding-bottom: 6px;
}

.team-header-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.team-header {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#teamNextRace {
    white-space: normal;
    text-overflow: clip;
}

.car-tab-image {
    width: 160px;
    height: 90px;
    align-self: center;
    margin-bottom: 4px;
}

.car-options-dialog {
    width: 520px;
    max-height: 85%;
}
.car-paint-preview {
    width: 100%;
    height: 195px;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.game-neutral .car-paint-color {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}
.car-paint-swatch {
    width: 34px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 10px;
    border-width: 1px;
    border-color: var(--game-divider);
}

.car-option-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    white-space: normal;
}

.car-option-image {
    width: 88px;
    height: 50px;
    margin-right: 10px;
    flex-shrink: 0;
}

#eventCarPicker {
    white-space: normal;
}

.car-option-row {
    background-color: rgb(40, 47, 56);
}

.car-option-row:hover {
    background-color: rgb(57, 66, 78);
}

.car-option-row Label {
    color: whitesmoke;
}

.track-player-panel {
    flex-shrink: 0;
    padding: 6px;
    border-top-width: 1px;
    border-color: #394350;
    font-size: 12px;
}
.pit-readouts {
    flex-direction: row;
}
.pit-tires {
    width: 110px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
}
.pit-tire {
    width: 50%;
    align-items: center;
}
.pit-tire .unity-base-field__label,
.pit-levels .unity-base-field__label {
    min-width: 0;
}
.track-player-panel .unity-toggle__checkmark {
    scale: 0.5 0.5;
}
.pit-tire-bar, .pit-level-bar {
    background-color: #10151e;
    border-width: 1px;
    border-color: #64768b;
    overflow: hidden;
}
.pit-tire-bar {
    width: 14px;
    height: 35px;
    justify-content: flex-end;
}
.pit-level-bar {
    height: 9px;
    flex-direction: row;
}
.pit-meter-fill {
    background-color: #57d568;
}
.pit-damage-fill {
    background-color: #ef694d;
}
.pit-levels {
    flex-grow: 1;
    min-width: 0;
    padding-left: 4px;
}
.pit-levels > Label {
    white-space: normal;
}
.track-player-panel .action {
    align-self: stretch;
    min-width: 0;
    height: 28px;
    font-size: 13px;
}
.practice-run-report {
    background-color: rgba(20, 28, 38, 0.96);
    border-radius: 6px;
    padding: 20px 24px;
    margin-top: 14px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.practice-run-group {
    flex-shrink: 0;
    padding-bottom: 22px;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: #526171;
}
.practice-run-report Label {
    color: #f4f7fb;
    font-size: 18px;
    white-space: normal;
    flex-shrink: 0;
    margin-top: 5px;
    margin-bottom: 7px;
}
.practice-run-report .practice-run-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}
.practice-run-tires {
    flex-direction: row;
    flex-wrap: nowrap;
    margin-top: 16px;
    margin-bottom: 18px;
    flex-shrink: 0;
}
.practice-run-tire {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}
.practice-run-tire .unity-progress-bar {
    height: 32px;
    min-height: 32px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.practice-run-report .unity-progress-bar__title {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #121a24;
}
.practice-run-laps {
    flex-shrink: 0;
    margin-top: 8px;
}
.practice-temperature-start {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: black;
}
.practice-run-laps > .unity-foldout__toggle {
    min-height: 32px;
    margin-bottom: 8px;
}
.practice-chart {
    background-color: #141c26;
    padding: 18px;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-basis: 0;
}
.practice-chart Label {
    color: #f4f7fb;
    font-size: 16px;
    margin-bottom: 8px;
}
.practice-chart Button {
    height: 38px;
    align-self: flex-start;
    margin-bottom: 14px;
}
.practice-chart Toggle {
    min-height: 25px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}
.practice-chart Toggle Label {
    font-size: 14px;
    margin-bottom: 0;
}
/* Vertical Garage sections must size to content, rather than sharing a zero basis. */
.event-garage-page {
    flex-shrink: 0;
}
.event-garage-page > .event-detail-panel {
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.event-garage-page > .event-overview {
    flex-shrink: 0;
    margin-bottom: 8px;
}
.event-garage-page .event-detail-panel > Label,
.event-garage-page > Label {
    flex-shrink: 0;
    min-height: 22px;
    margin-bottom: 6px;
}
.event-garage-page .event-tire-row {
    min-height: 30px;
    flex-shrink: 0;
}
.event-garage-page .event-tire-row > .garage-detail {
    width: 82px;
    min-width: 82px;
    flex-shrink: 0;
    white-space: nowrap;
}
.event-garage-page .garage-fuel-panel {
    min-height: 112px;
}
.event-garage-page #garageStartingFuel {
    flex-shrink: 0;
    height: 32px;
}
.event-garage-page #garageStartingFuel > .unity-base-field__label {
    min-width: 135px;
    flex-shrink: 0;
    color: #f4f7fb;
}
.event-garage-page #garageStartingFuel .unity-text-field__input {
    background-color: #263342;
    color: #ffffff;
    min-width: 52px;
}
.garage-simulation-controls {
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 42px;
    margin: 0 8px 18px;
}
.garage-simulation-controls > .unity-dropdown-field {
    width: 170px;
    min-width: 170px;
    height: 32px;
    margin-right: 12px;
}
.garage-simulation-controls .unity-base-field__label {
    min-width: 40px;
    width: 40px;
    flex-shrink: 0;
    color: #f4f7fb;
}
.garage-simulation-controls > Button {
    min-width: 130px;
    height: 32px;
    margin-top: 0;
    margin-bottom: 0;
}
.event-garage-page .shop-component-row {
    flex-shrink: 0;
}
.event-overview > .event-detail-panel {
    flex-grow: 1;
    flex-basis: 0;
}
.event-information-page,
.event-information-page > .event-overview {
    flex-shrink: 0;
}
.event-information-page > .event-overview {
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.event-information-page > .event-overview > .event-detail-panel {
    flex-basis: 320px;
}
.event-information-page .event-detail-panel > Label {
    flex-shrink: 0;
    min-height: 22px;
    white-space: normal;
    margin-bottom: 8px;
}
.event-information-page .schedule-race {
    min-height: 54px;
    padding-top: 8px;
    padding-bottom: 8px;
}
.event-information-page .event-track-outline {
    flex-shrink: 0;
}
.event-information-page .track-ratings {
    flex-wrap: wrap;
    flex-shrink: 0;
}
.event-information-page .rating-column {
    flex-basis: 76px;
    min-width: 76px;
    flex-shrink: 0;
    margin-bottom: 10px;
}
.event-information-page .rating-label,
.event-information-page .rating-well,
.event-information-page .shop-component-row {
    flex-shrink: 0;
}
.event-information-page .rating-label {
    min-height: 20px;
}
#titleScreen > .main {
    min-height: 0;
    padding-bottom: 16px;
}
.title-card {
    max-height: 100%;
    flex-shrink: 1;
}
.title-logo {
    min-height: 100px;
    flex-shrink: 1;
}
.title-card > .title-actions {
    align-self: stretch;
    justify-content: space-between;
    flex-shrink: 0;
}
.title-card > .title-actions > .action {
    margin-right: 0;
}
#titleScreen > .title-icon-row {
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 10px;
    margin-top: 0;
}
.title-career-list {
    min-height: 110px;
    flex-shrink: 1;
}
.title-career-list .title-career-row {
    margin: 4px;
    background-color: #1f2730;
    border-width: 1px;
    border-color: #8ca4bb;
    border-radius: 8px;
}
.title-career-list .title-career-load {
    margin: 0;
    border-width: 0;
    border-radius: 7px;
}
.title-career-list .title-career-delete {
    width: 40px;
    min-width: 40px;
    height: 40px;
    padding: 0;
    margin: 0 6px;
    border-width: 0;
    background-color: transparent;
}
.title-career-list .title-career-delete:hover,
.title-career-list .title-career-delete:focus {
    color: #ffffff;
    background-color: #394a60;
}

.title-career-confirmation-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin: 4px 0;
}
.title-career-confirmation-actions > .settings-button {
    flex-shrink: 0;
    min-width: 120px;
    min-height: 40px;
    padding: 6px 16px;
    white-space: nowrap;
}
.title-career-confirmation-actions > .title-career-confirm-delete {
    min-width: 150px;
    color: #ff8c8c;
    border-color: #ff8c8c;
}

.title-career-action {
    min-width: 170px;
    min-height: 44px;
    font-size: 17px;
}
.title-career-list .title-career-row {
    width: auto;
}
#careerPickerDialog .title-career-list {
    max-height: 460px;
}

#careerPickerDialog .settings-confirmation-dialog,
#deleteCareerConfirmation .settings-confirmation-dialog {
    background-color: #10151e;
    border-color: #009bdd;
}
#careerPickerDialog .settings-confirmation-actions,
#deleteCareerConfirmation .settings-confirmation-actions {
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: #009bdd;
}
#careerPickerDialog .title-career-row .title-career-load {
    background-color: #1f2730;
}
#careerPickerDialog .title-career-row:hover {
    background-color: #263e50;
    border-color: #009bdd;
}
#careerPickerDialog .title-career-row:hover .title-career-load,
#careerPickerDialog .title-career-row .title-career-load:focus {
    background-color: #263e50;
}

#titleScreen > .title-icon-row {
    align-self: center;
    width: 100%;
    max-width: 800px;
    min-height: 56px;
    flex-wrap: nowrap;
}
#titleScreen > .title-icon-row > .title-icon-button {
    margin-left: 4px;
    margin-right: 4px;
}
#titleScreen > .title-icon-row > .title-quit-icon {
    margin-right: 0;
}

#newCareerSeriesPicker .title-career-row .title-career-load {
    background-color: #1f2730;
}
#newCareerSeriesPicker .title-career-row:hover {
    border-color: #009bdd;
    background-color: #263e50;
}
#newCareerSeriesPicker .title-career-row:hover .title-career-load,
#newCareerSeriesPicker .title-career-load:focus {
    background-color: #263e50;
}

.new-career-form .settings-group {
    margin-top: 3px;
    margin-bottom: 3px;
    padding-top: 6px;
    padding-bottom: 6px;
}
.new-career-form .settings-field {
    margin-top: 3px;
    margin-bottom: 3px;
}
.new-career-form .car-paint-preview {
    height: 140px;
    min-height: 100px;
}
.new-career-form .settings-error-slot {
    height: 27px;
    margin-bottom: 1px;
}
.new-career-form .title-career-row .title-career-load {
    background-color: #1f2730;
}
.new-career-form .title-career-row:hover {
    border-color: #009bdd;
    background-color: #263e50;
}
.new-career-form .title-career-row:hover .title-career-load,
.new-career-form .title-career-load:focus {
    background-color: #263e50;
}

.new-career-form .settings-header {
    margin-bottom: 6px;
}
.new-career-form .settings-field > .unity-base-field__input {
    min-height: 36px;
}
.new-career-form .settings-field .settings-button {
    min-height: 36px;
}
.new-career-form .car-paint-preview {
    margin-bottom: 2px;
}
.new-career-form .settings-row > .settings-field {
    flex-basis: 0;
}

.new-career-form .career-car-preview-panel > .car-paint-preview {
    height: 110px;
    min-height: 80px;
}
.career-inline-paint .career-car-setup-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.career-inline-paint .career-car-preview-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    margin-right: 16px;
    justify-content: center;
}
.career-inline-paint .career-car-preview-panel > .car-paint-preview {
    flex-grow: 1;
    flex-basis: 0;
    height: auto;
    min-height: 0;
    max-height: 560px;
}
.career-inline-paint .career-car-paint-controls {
    width: 276px;
    flex-shrink: 0;
    align-self: center;
}
.career-inline-paint .career-car-paint-controls .settings-field {
    flex-grow: 0;
    flex-shrink: 0;
}

.new-career-form.career-identity-page {
    justify-content: center;
}
.new-career-form.career-identity-page > .settings-frame {
    height: auto;
    flex-grow: 0;
}
.career-identity-page .career-player-form {
    flex-grow: 0;
}
.career-identity-page .career-player-form > .settings-field {
    flex-grow: 0;
    margin-top: 2px;
    margin-bottom: 2px;
}
.career-identity-page .career-player-form .settings-note {
    margin-top: 0;
    margin-bottom: 2px;
}

.track-display-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
#trackGrandstandsButton, #trackPracticeSkyButton, #requestCautionButton {
    margin-left: 6px;
}
.track-detail-control {
    align-self: center;
    flex-shrink: 0;
    min-height: 28px;
    margin: 3px 0;
    padding: 3px 10px;
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 7px;
    background-color: #10151e;
    color: #f5f5f5;
    font-size: 12px;
}
.track-detail-control:hover, .track-detail-control:focus {
    background-color: #263e50;
    border-color: #55c4ef;
}

.team-header-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0 0 0 8px;
    border-width: 0;
    border-radius: 6px;
    background-color: transparent;
    color: #f5f5f5;
}
.team-header-icon:hover, .team-header-icon:focus {
    color: #55c4ef;
    background-color: #263e50;
}
.team-header-icon#garageQuitButton:hover,
.team-header-icon#garageQuitButton:focus {
    color: #ff8c8c;
}

/* Shared Teams header, in identity / balance / next race / actions order. */
.header.team-header-row {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    min-height: 76px;
}
.team-logo-placeholder {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 8px;
    background-color: #182634;
    margin-right: 12px;
}
.team-logo-placeholder Label { font-size: 11px; color: #55c4ef; }
.team-header-name {
    font-size: 22px;
    -unity-font-style: bold;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 12px;
}
.team-series-logo-slot {
    width: 88px;
    height: 48px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
}
#teamHeaderSeriesLogo { width: 100%; height: 100%; }
#teamHeaderSeriesPlaceholder { font-size: 11px; color: #55c4ef; }
.team-header-series-title {
    font-size: 15px;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 12px;
}
.team-header-next-race {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 95px;
    max-width: 210px;
    margin-right: 12px;
}
.team-header-next-race Label { margin: 0; padding: 0; white-space: normal; }
.team-header-caption { font-size: 11px; color: #55c4ef; }
.team-header-track { font-size: 14px; -unity-font-style: bold; }
.team-header-date { font-size: 12px; }
.team-header-balance { flex-direction: column; flex-shrink: 0; margin-right: 12px; }
.team-header-balance Label { margin: 0; padding: 0; white-space: nowrap; }
.team-header-balance-amount { font-size: 14px; -unity-font-style: bold; }
.team-header-balance-spacer { visibility: hidden; }
.team-header-actions { flex-wrap: nowrap; flex-shrink: 0; align-items: center; }

.title-card > .title-actions {
    justify-content: flex-start;
    flex-wrap: nowrap;
}
.title-card > .title-actions > .title-career-action {
    align-self: flex-start;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 12px;
    min-width: 170px;
    flex-shrink: 0;
}
.title-card > .title-actions > #newCareerButton { margin-left: auto; margin-right: 0; }

.title-card > .title-actions { align-items: flex-start; }
.title-continue-controls {
    flex-direction: column;
    width: 170px;
    min-width: 170px;
    flex-shrink: 0;
    margin-right: 8px;
}
.title-continue-controls > .title-career-action {
    align-self: flex-start;
    margin: 0;
}
.title-continue-details {
    width: 320px;
    flex-shrink: 0;
    font-size: 13px;
    color: #f5f5f5;
    white-space: nowrap;
    margin: 6px 0 0 10px;
    padding: 0;
}

.team-paint-choice {
    width: 47%;
    height: 103px;
    flex-direction: column;
    background-color: #182634;
    border-color: #34495f;
}
.team-paint-choice:hover, .team-paint-choice:focus {
    background-color: #263e50;
    border-color: #009bdd;
}

.team-paint-choice.team-paint-choice-selected {
    border-width: 2px;
    border-color: #009bdd;
}

.garage-footer {
    border-top-color: #009bdd;
}
.garage-footer .team-footer-button {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: auto;
    min-height: 40px;
    margin: 0 3px;
    padding: 5px 9px;
    font-size: 13px;
    white-space: nowrap;
    color: #f5f5f5;
    background-color: #182634;
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 8px;
}
.garage-footer .team-footer-button:hover,
.garage-footer .team-footer-button:focus {
    background-color: #263e50;
    border-color: #55c4ef;
}
.garage-footer .team-footer-button.settings-tab-current {
    background-color: #155374;
    border-color: #55c4ef;
}
.garage-footer .team-footer-button:disabled { opacity: 0.44; }

.team-home-page { flex-grow: 1; min-height: 0; }
.team-home-columns { flex-direction: row; flex-grow: 1; min-height: 0; padding-top: 12px; }
.team-home-column { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin: 0 5px; }
.team-home-panel {
    background-color: rgba(16, 21, 30, 0.94);
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 10px;
    min-height: 0;
}
.team-home-fill { flex-grow: 1; flex-basis: 0; }
.team-home-heading { font-size: 16px; -unity-font-style: bold; color: #f5f5f5; white-space: normal; margin: 0 0 8px; }
.team-home-list { flex-grow: 1; flex-basis: 0; min-height: 90px; }
.team-home-note { color: #b7c6d5; font-size: 13px; white-space: normal; }
.team-home-task { white-space: normal; margin: 0 0 6px; padding: 8px; flex-shrink: 0; background-color: #182634; border-color: #009bdd; }
.team-home-result { flex-direction: row; align-items: center; margin: 0 0 5px; padding: 7px; background-color: #182634; border-color: #34495f; }
.team-home-result:hover, .team-home-task:hover { background-color: #263e50; border-color: #55c4ef; }
.team-home-track { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 13px; }
.team-home-finish { flex-shrink: 0; font-size: 14px; color: #55c4ef; -unity-font-style: bold; margin-left: 6px; }
.team-home-row { flex-direction: row; align-items: center; padding: 3px 4px; min-height: 24px; }
.team-home-column-headings { background-color: #263e50; -unity-font-style: bold; }
.team-home-position { width: 32px; flex-shrink: 0; font-size: 13px; }
.team-home-driver { flex-shrink: 1; white-space: normal; font-size: 13px; }
.team-home-player { background-color: #155374; }

/* Upright derivative of the licensed racing face for team identity and Home titles. */
.team-header-name,
.team-home-heading {
    -unity-font-definition: url("../Fonts/SCMUprightDisplay-Regular.ttf");
    -unity-font-style: normal;
}

.team-home-car-number { width: 36px; flex-shrink: 0; font-size: 13px; }

.team-home-driver { flex-grow: 1; min-width: 0; }
.team-home-points { width: 48px; flex-shrink: 0; font-size: 13px; -unity-text-align: middle-right; }

.team-home-task { flex-direction: row; align-items: center; }
.team-home-task > .track-icon-art { flex-shrink: 0; margin-right: 8px; color: #55c4ef; }
.team-home-task-text { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; margin: 0; padding: 0; }

.team-home-response-alert {
    color: #ffaf63;
    font-size: 22px;
    -unity-font-style: bold;
    flex-shrink: 0;
    width: 18px;
    margin-left: 8px;
    margin-right: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.team-home-task-text { -unity-text-align: middle-left; }

.team-home-track { -unity-text-align: middle-left; }

.team-home-car-preview { height: 85px; flex-shrink: 1; min-height: 50px; }
.team-home-chassis-name { font-size: 13px; -unity-font-style: bold; margin: 2px 0 5px; }
.team-home-component-row { flex-direction: row; min-height: 19px; align-items: center; }
.team-home-component-name { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 11px; margin: 0; -unity-text-align: middle-left; }
.team-home-component-value { width: 48px; flex-shrink: 0; font-size: 11px; margin: 0; -unity-text-align: middle-right; }
.team-home-track-identity { flex-direction: row; align-items: center; min-height: 34px; }
.team-home-track-logo { width: 62px; height: 34px; flex-shrink: 0; margin-right: 8px; }
.team-home-track-logo-placeholder { width: 62px; height: 34px; flex-shrink: 0; margin: 0 8px 0 0; font-size: 10px; color: #55c4ef; background-color: #182634; -unity-text-align: middle-center; border-width: 1px; border-color: #009bdd; border-radius: 5px; }
.team-home-next-track-name { flex-grow: 1; flex-shrink: 1; font-size: 13px; white-space: normal; -unity-text-align: middle-left; }
.team-home-track-outline { height: 65px; min-height: 35px; flex-shrink: 1; margin: 4px 0; }
.team-home-race-detail { font-size: 11px; white-space: normal; margin: 1px 0; padding: 0; }

#homeSuggestedCarPanel .car-card-rating-row { min-height: 22px; font-size: 11px; }
#homeSuggestedCarPanel .car-card-component { width: 77px; }
#homeSuggestedCarPanel .car-card-rating-heading { font-size: 11px; }
#homeSuggestedCarPanel .car-card-value { width: 30px; font-size: 10px; }

.team-home-car-preview { background-color: transparent; }
.team-home-track-identity { align-items: flex-start; flex-shrink: 0; }
.team-home-race-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.team-home-race-text > .team-home-next-track-name { flex-grow: 0; margin: 0; }
#homeNextRacePanel > .team-home-track-outline { margin-top: auto; flex-grow: 1; max-height: 95px; }

.team-home-result-date {
    width: 42px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.team-home-chassis-mismatch { color: #ffaf63; font-size: 11px; white-space: normal; margin: 0 0 4px; }

.home-component-icon-slot { position: relative; width: 32px; height: 22px; flex-shrink: 0; }
.home-component-icon-slot > .shop-component-icon {
    position: absolute;
    left: -4px;
    top: -9px;
    width: 40px;
    height: 40px;
    margin: 0;
    scale: 0.55 0.55;
}

/* Inset title badges overlap each Home panel's top border. */
.team-home-panel {
    overflow: visible;
    margin-top: 10px;
    padding-top: 18px;
}
.team-home-panel > .team-home-heading {
    position: absolute;
    left: 10px;
    top: -12px;
    max-width: 94%;
    margin: 0;
    padding: 0 6px;
    background-color: rgba(16, 21, 30, 0.94);
    color: #009bdd;
    font-size: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Paint the panel/title surface once to avoid compounded translucency. */
.team-home-panel { background-color: transparent; border-color: transparent; }
.team-home-panel > .team-home-heading { background-color: transparent; }

#homeStandingsRows .team-home-row {
    height: 19px;
    min-height: 19px;
    flex-shrink: 0;
    padding-top: 0;
    padding-bottom: 0;
}
#homeStandingsRows .team-home-row > Label {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.team-header-name { color: #009bdd; }
.team-header-series-title {
    -unity-font-definition: url("../Fonts/SCMUprightDisplay-Regular.ttf");
    -unity-font-style: normal;
}

.team-header-series-title { color: #009bdd; }

.team-home-next-track-name { -unity-font-style: bold; }

.team-home-race-text > .team-home-race-detail { margin-top: 0; }

/* Mail shares Team panel titles, typography, and rounded control styling. */
.mail-page { padding-top: 10px; }
.mail-email.team-home-panel, .mail-social.team-home-panel {
    padding: 18px 12px 12px;
    border-width: 1px;
    border-color: transparent;
    min-height: 0;
}
.mail-social.team-home-panel { margin-left: 14px; }
.mail-inbox { min-width: 150px; }
.mail-reader {
    padding: 10px;
    background-color: rgba(16, 21, 30, 0.55);
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 8px;
}
.mail-inbox-header > .mail-subheading { color: #009bdd; font-size: 14px; }
.mail-page .settings-button { color: #f5f5f5; border-radius: 8px; }
.mail-page .mail-message-row {
    background-color: #182634;
    border-width: 1px;
    border-color: #34495f;
    flex-direction: column;
    justify-content: center;
}
.game-neutral .mail-page .mail-message-row.mail-unread {
    background-color: #1b3040;
    border-left-color: #009bdd;
}
.mail-page .mail-message-row:hover,
.mail-page .mail-message-row:focus {
    background-color: #263e50;
    border-color: #55c4ef;
}
.mail-page .mail-message-row.settings-tab-current {
    background-color: #155374;
    border-color: #009bdd;
}
.game-neutral .mail-page .mail-message-row.mail-scenario { border-color: #ffaf63; }
.mail-page .mail-scenario-alert { color: #ffaf63; }
.mail-page .mail-scenario-choice {
    background-color: #182634;
    border-color: #009bdd;
    white-space: normal;
    padding: 7px 12px;
}
.mail-page .mail-scenario-choice:hover { background-color: #263e50; border-color: #55c4ef; }
.mail-page .mail-post { background-color: #182634; border-width: 1px; border-color: #34495f; border-radius: 8px; }
.mail-page .mail-post-delete { background-color: transparent; border-width: 0; color: #55c4ef; }
.mail-page .mail-post-delete:hover { color: #ff8c8c; background-color: #263e50; }
.mail-feed-actions { justify-content: flex-end; margin-bottom: 6px; }
.mail-page .mail-message-title { color: #f5f5f5; font-size: 18px; }
.mail-page .mail-subject, .mail-page .mail-sender { -unity-text-align: middle-left; }

.garage-team-color-background {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.garage-team-color-background > .team-header-row,
.garage-team-color-background > .garage-footer { background-color: rgba(16, 21, 30, 0.88); }

/* Open Sans is the default face for panel titles; Team header identity stays upright racing. */
.team-home-heading,
.panel-title,
.schedule-heading,
.car-card-title,
.mail-inbox-header > .mail-subheading {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Regular.ttf");
    -unity-font-style: normal;
}

.team-home-task-text { -unity-font-style: bold; }

.team-home-heading,
.panel-title,
.schedule-heading,
.car-card-title,
.mail-inbox-header > .mail-subheading {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}

#homeSuggestedCarPanel .car-card-rating-heading {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}

/* Home text uses the actual bold face; shared header identity keeps its racing face. */
#homePage,
#homePage Label,
#homePage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}

/* Shared Teams header and footer typography; retain racing identity labels. */
.team-header-row,
.team-header-row Label,
.team-header-row Button,
.garage-footer,
.garage-footer Label,
.garage-footer Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}
.team-header-row .team-header-name,
.team-header-row .team-header-series-title {
    -unity-font-definition: url("../Fonts/SCMUprightDisplay-Regular.ttf");
    -unity-font-style: normal;
}

/* Mail typography uses the licensed bold face while preserving existing colors. */
#mailPage,
#mailPage Label,
#mailPage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}

.team-header-row .team-header-series-title { font-size: 22px; }

/* Finance panels share the translucent Team title treatment and typography. */
#financesPage,
#financesPage Label,
#financesPage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}
.finance-page { flex-grow: 1; min-height: 0; }
#financesPage .finance-summary { flex-shrink: 0; margin-bottom: 8px; }
#financesPage .finance-card {
    padding: 20px 12px 12px;
    min-height: 66px;
    margin: 10px 6px 6px;
}
#financesPage .finance-total { font-size: 21px; }
#financesPage .finance-report-panel { flex-grow: 1; flex-basis: 0; min-height: 0; }
#financesPage .finance-report-scroll { flex-grow: 1; min-height: 0; }
#financeBreakdown { border-width: 0; background-color: transparent; }
#financeBreakdown .results-grid-row { min-height: 27px; border-bottom-color: #263e50; }
#financeBreakdown .results-grid-header { background-color: #182634; }
#financeBreakdown .finance-group-toggle {
    min-height: 29px;
    border-width: 1px;
    border-color: #34495f;
    border-radius: 7px;
    background-color: #182634;
    color: #f5f5f5;
    margin: 2px 0;
}
#financeBreakdown .finance-group-toggle:hover,
#financeBreakdown .finance-group-toggle:focus { background-color: #263e50; border-color: #009bdd; }
#financeBreakdown .finance-description { white-space: normal; }
#financeBreakdown .finance-number { -unity-text-align: middle-right; }

#financesPage Label.finance-estimates-note {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Regular.ttf");
    -unity-font-style: normal;
}

#carsPage,
#carsPage Label,
#carsPage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}
#carsPage .car-panel {
    background-color: transparent;
    border-color: transparent;
    border-radius: 10px;
    padding: 18px 12px 12px;
    margin-top: 14px;
    margin-bottom: 8px;
}
#carsPage .car-card-image { background-color: transparent; }
#carsPage .team-home-heading { color: #009bdd; }
#carsPage .car-card-specs { font-size: 12px; margin-bottom: 10px; }
#carsPage .car-card-action {
    border-radius: 8px;
    border-width: 1px;
    border-color: #009bdd;
    background-color: #182634;
    color: #55c4ef;
    margin-bottom: 0;
}
#carsPage .car-card-action:hover,
#carsPage .car-card-action:focus { background-color: #263e50; border-color: #55c4ef; }
#carsPage .car-card-action:disabled { opacity: 0.44; }
#carsPage #addTeamCarButton { border-color: #009bdd; background-color: #182634; padding: 7px 13px; }
#carsPage #addTeamCarButton:hover { background-color: #263e50; border-color: #55c4ef; }

/* Keep full panel strokes inside the Cars scroll viewport. */
.car-tabs .unity-scroll-view__content-container { padding-left: 2px; padding-right: 2px; }
#shopPage,
#shopPage Label,
#shopPage Button,
.shop-chassis-dialog Label,
.shop-chassis-dialog Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
    -unity-font-style: normal;
}
#shopPage .shop-car-components { background-color: transparent; padding: 4px 2px; }
#shopPage .shop-component-row.team-home-panel {
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    min-height: 76px;
    padding: 14px 10px 7px;
    margin-top: 10px;
    margin-bottom: 8px;
}
#shopPage .team-home-heading { color: #009bdd; }
#shopPage .shop-component-action-button {
    background-color: #182634;
    border-width: 1px;
    border-color: #009bdd;
    border-radius: 8px;
    color: #55c4ef;
}
#shopPage .shop-component-action-button:hover { background-color: #263e50; border-color: #55c4ef; }
#shopPage .shop-component-action-button:disabled { opacity: 0.44; }
#shopPage .shop-car-toggle { background-color: #10151e; border-color: #009bdd; border-radius: 8px; color: #f5f5f5; }
#shopPage .shop-car-toggle:hover { background-color: #263e50; border-color: #55c4ef; }
.shop-chassis-dialog { background-color: #10151e; border-color: #009bdd; width: 620px; }
.shop-chassis-dialog .shop-car-choice { background-color: #182634; color: #f5f5f5; border-color: #34495f; border-radius: 8px; }
.shop-chassis-dialog .shop-car-choice:hover,
.shop-chassis-dialog .shop-car-choice:focus { background-color: #263e50; border-color: #009bdd; }
.shop-chassis-dialog .shop-car-choice.settings-tab-current { border-color: #009bdd; }
.shop-chassis-dialog .shop-car-thumbnail { background-color: transparent; }

#shopPage .shop-components-group {
    padding: 16px 12px 8px;
    margin-top: 10px;
    margin-bottom: 8px;
}
#shopPage .shop-components-group > .shop-component-row {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #263e50;
    margin: 0;
    padding: 5px 0;
    min-height: 72px;
}

/* Fit all five Shop component rows within the page, including active repair details. */
#shopPage { flex-grow: 1; min-height: 0; padding-top: 12px; padding-bottom: 8px; }
#shopPage .shop-car-components { margin-top: 66px; padding-top: 0; padding-bottom: 0; }
#shopPage .shop-components-group { padding: 14px 10px 6px; margin-top: 8px; margin-bottom: 0; }
#shopPage .shop-components-group > .shop-component-row { min-height: 50px; padding: 2px 0; }
#shopPage .shop-component-action-line { min-height: 22px; margin: 0; }
#shopPage .shop-component-action-button { width: 22px; height: 22px; min-width: 22px; min-height: 22px; }
#shopPage .shop-component-caption,
#shopPage .shop-component-mechanic { font-size: 12px; margin-top: 0; margin-bottom: 2px; }
#shopPage .shop-component-action-cost { font-size: 12px; }
#shopPage .employee-portrait.shop-repair-portrait { width: 32px; height: 32px; margin-right: 6px; }
#shopPage .shop-component-icon { margin-right: 10px; }

/* Center Components within the area below the chassis selector. */
#shopPage .shop-car-components {
    flex-grow: 1;
    min-height: 0;
    justify-content: center;
    margin-top: 66px;
}
#shopPage .shop-components-group {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 8px;
}

#shopPage .shop-car-picker {
    position: relative;
    top: auto;
    left: auto;
    width: auto;
    max-width: 100%;
    height: 110px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}
#shopPage .shop-car-components { margin-top: 0; }
.shop-chassis-strip { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 110px; }
.shop-chassis-strip .unity-scroll-view__content-container { flex-direction: row; padding: 12px 3px 4px; }
#shopPage .shop-strip-card {
    width: 286px;
    height: 88px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    padding: 14px 8px 5px;
    background-color: transparent;
    border-color: transparent;
    opacity: 0.78;
}
#shopPage .shop-strip-card.shop-strip-selected,
#shopPage .shop-strip-card:hover,
#shopPage .shop-strip-card:focus { opacity: 1; }
.shop-strip-card-content { flex-direction: row; align-items: center; flex-grow: 1; }
.shop-strip-image { width: 130px; height: 60px; flex-shrink: 0; background-color: transparent; }
.shop-strip-specs { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 8px; }
#shopPage .shop-strip-arrow {
    width: 22px;
    min-width: 22px;
    height: 88px;
    flex-shrink: 0;
    padding: 0;
    margin: 6px 4px 0;
    border-radius: 6px;
    border-color: #009bdd;
    color: #55c4ef;
    background-color: #182634;
}
#shopPage .shop-strip-arrow:hover { background-color: #263e50; }
#shopPage .shop-strip-arrow:disabled { opacity: 0.35; }

/* Center the compact selector + Components stack, rather than centering Components alone. */
#shopPage {
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
}
#shopPage .shop-car-picker { margin-top: 0; }
#shopPage .shop-car-components {
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    margin-top: 8px;
}
#shopPage .shop-components-group { margin-top: 8px; margin-bottom: 8px; }

/* Compact shared Team view margins, with breathing room inside the header/footer. */
.garage-screen { padding: 12px 16px; }
.garage-screen .garage-page { padding: 10px 6px; }
.garage-screen .garage-page.event-setup-page { padding: 4px 6px; }
.garage-screen > .team-header-row,
.garage-screen > .garage-footer {
    padding-left: 12px;
    padding-right: 12px;
}

/* Edge-to-edge Team header/footer; keep horizontal margins around tab content only. */
.garage-screen { padding: 0; }
.garage-screen > .garage-body,
.garage-screen > .garage-page { margin-left: 16px; margin-right: 16px; }
.garage-screen > .team-header-row,
.garage-screen > .garage-footer { margin: 0; }

#employeesPage,
