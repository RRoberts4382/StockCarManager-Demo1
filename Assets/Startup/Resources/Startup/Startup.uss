.new-chassis-total { flex-grow: 1; -unity-text-align: middle-right; margin-right: 16px; font-size: 18px; color: whitesmoke; }

.new-chassis-component-row > .home-component-icon-slot { width: 40px; height: 38px; flex-shrink: 0; }
.new-chassis-component-row .home-component-icon-slot > .shop-component-icon { scale: 0.75 0.75; left: 0; top: -2px; }
.new-chassis-level-bar { flex-grow: 1; flex-shrink: 1; min-width: 70px; margin-right: 12px; flex-direction: row; align-items: center; }
.new-chassis-level-bar > .car-card-metric { flex-grow: 1; min-width: 0; }

.new-chassis-total-row { flex-direction: column; align-items: flex-end; }
.new-chassis-total-row > .new-chassis-total { flex-grow: 0; margin-right: 0; -unity-text-align: middle-right; }
#carMarketPage .new-chassis-total-row > .car-purchase-buy-button { margin-right: 0; margin-top: 6px; }
.new-chassis-upgrade-price { flex-shrink: 0; margin-right: 0; padding-right: 0; }

.new-chassis-budget-error { align-self: flex-end; flex-shrink: 0; margin-top: 4px; }
.new-chassis-budget-error > .settings-inline-error { white-space: normal; }

.new-chassis-component-heading { flex-direction: row; align-items: center; flex-shrink: 0; }
.new-chassis-component-heading > .settings-group-heading { flex-grow: 1; margin-bottom: 0; }
#carMarketPage .new-chassis-component-heading > .settings-button { min-height: 30px; margin: 0; padding: 3px 12px; }

.new-chassis-total-line { flex-direction: row; align-self: stretch; justify-content: flex-end; align-items: center; }
.new-chassis-total-caption { margin-right: 12px; font-size: 18px; color: whitesmoke; }
.new-chassis-total-value { width: 120px; flex-shrink: 0; margin-right: 0; padding-right: 0; -unity-text-align: middle-right; font-size: 18px; color: whitesmoke; }
.new-chassis-purchase-actions { flex-direction: row; justify-content: flex-end; margin-top: 6px; flex-shrink: 0; }
#carMarketPage .new-chassis-purchase-actions > .settings-button { margin: 0 0 0 8px; }

#carMarketPage .new-chassis-total-field { width: 120px; flex-grow: 0; flex-shrink: 0; align-self: flex-end; margin-right: 0; }
#carMarketPage .new-chassis-total-field .unity-text-field__input { -unity-text-align: middle-right; }

#carMarketPage .new-chassis-upgrade-price { width: 120px; min-width: 120px; max-width: 120px; padding-right: 10px; -unity-text-align: middle-right; }
#carMarketPage .new-chassis-total-field { min-width: 120px; max-width: 120px; padding-left: 0; padding-right: 0; }
#carMarketPage .new-chassis-total-field .unity-base-text-field__input { margin-left: 0; margin-right: 0; padding-right: 9px; border-right-width: 1px; -unity-text-align: middle-right; }
#carMarketPage .new-chassis-total-field .unity-text-element { -unity-text-align: middle-right; }

#carMarketPage .new-chassis-component-row > .new-chassis-upgrade-price { flex-grow: 0; flex-shrink: 0; flex-basis: auto; width: 120px; min-width: 120px; max-width: 120px; margin: 0; padding-left: 0; padding-right: 0; }
#carMarketPage .new-chassis-upgrade-price .unity-base-text-field__input { margin-left: 0; margin-right: 0; padding-right: 9px; border-right-width: 1px; -unity-text-align: middle-right; }
#carMarketPage .new-chassis-upgrade-price .unity-text-element { -unity-text-align: middle-right; }

#carMarketPage .new-chassis-components { min-width: 0; align-items: stretch; }
#carMarketPage .new-chassis-component-row { align-self: stretch; }
#carMarketPage .new-chassis-components > .new-chassis-total-row { align-self: stretch; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }

#carMarketPage .new-chassis-upgrade-price .unity-base-text-field__input,
#carMarketPage .new-chassis-total-field .unity-base-text-field__input {
    border-width: 0;
    padding-right: 10px;
}

#carMarketPage .new-chassis-upgrade-price,
#carMarketPage .new-chassis-total-field,
#carMarketPage .new-chassis-upgrade-price .unity-base-text-field__input,
#carMarketPage .new-chassis-total-field .unity-base-text-field__input,
#carMarketPage .new-chassis-upgrade-price .unity-text-element,
#carMarketPage .new-chassis-total-field .unity-text-element {
    background-color: transparent;
}

.chassis-purchase-confirmation { height: auto; min-height: 0; padding: 14px 18px; }
.chassis-purchase-confirmation > .settings-group-heading { margin-bottom: 0; }
.chassis-purchase-confirmation > .settings-footer { flex-grow: 0; flex-shrink: 0; margin-top: 10px; padding-top: 8px; }

#carsPage .car-panel-selected { border-width: 2px; border-color: #55c4ef; }

#standingsPage { flex-grow: 1; min-height: 0; padding: 10px 6px; -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf"); }
.championship-season-heading { color: #f5f5f5; font-size: 17px; margin-bottom: 18px; flex-shrink: 0; }
.championship-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.championship-panel { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; margin: 0 5px; padding: 18px 10px 10px; }
.championship-list { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.championship-column-headings { flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #009bdd; margin-bottom: 4px; }
#standingsPage .standings-row { height: 24px; min-height: 24px; flex-shrink: 0; padding-top: 0; padding-bottom: 0; }
#standingsPage .results-grid-cell { color: #f5f5f5; font-size: 12px; padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#standingsPage .standings-position { flex-basis: 32px; flex-shrink: 0; }
#standingsPage .standings-car-number { flex-basis: 42px; flex-shrink: 0; }
#standingsPage .standings-points { flex-basis: 52px; flex-shrink: 0; -unity-text-align: middle-right; }
#standingsPage .results-grid-name { flex-grow: 1; flex-basis: 0; min-width: 0; }
#standingsPage .standings-player { background-color: rgba(0, 155, 221, 0.2); }
#schedulePage .schedule-events { margin-left: 0; }
.garage-footer .team-footer-button { padding-left: 7px; padding-right: 7px; }

#standingsPage .standings-wins { flex-grow: 0; flex-shrink: 0; flex-basis: 38px; -unity-text-align: middle-center; }

.championship-right-column { flex-direction: column; flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; margin: 0 5px; }
#standingsPage .championship-right-column > .championship-panel { margin-left: 0; margin-right: 0; }
#standingsPage .championship-manufacturers { flex-grow: 0; flex-basis: auto; height: 190px; min-height: 120px; flex-shrink: 1; margin-bottom: 24px; }
#standingsPage .championship-owners { flex-grow: 1; flex-basis: 0; min-height: 100px; }

/* Match header/body widths and include space for label padding. */
#standingsPage .results-grid-cell { margin-left: 0; margin-right: 0; padding-left: 4px; padding-right: 4px; }
#standingsPage .standings-position { flex-grow: 0; flex-shrink: 0; flex-basis: 42px; min-width: 42px; }
#standingsPage .standings-car-number { flex-grow: 0; flex-shrink: 0; flex-basis: 54px; min-width: 54px; }
#standingsPage .standings-wins { flex-grow: 0; flex-shrink: 0; flex-basis: 52px; min-width: 52px; }
#standingsPage .standings-points { flex-grow: 0; flex-shrink: 0; flex-basis: 64px; min-width: 64px; }
#standingsPage .championship-column-headings .results-grid-cell { text-overflow: clip; }
#standingsPage .championship-column-headings .results-grid-name { min-width: 110px; }

#standingsPage .standings-top-five,
#standingsPage .standings-top-ten { flex-grow: 0; flex-shrink: 0; flex-basis: 58px; min-width: 58px; -unity-text-align: middle-center; }

/* Reserve more width for driver identities and their additional finish-count columns. */
#standingsPage .championship-columns > .championship-panel {
    flex-grow: 1.7;
    flex-basis: 0;
}
#standingsPage .championship-columns > .championship-right-column {
    flex-grow: 1;
    flex-basis: 0;
}

#standingsPage .standings-row {
    align-items: stretch;
}
#standingsPage .standings-row > .results-grid-cell {
    align-self: stretch;
    -unity-text-align: middle-center;
}
#standingsPage .standings-row > .results-grid-name {
    -unity-text-align: middle-left;
}
#standingsPage .standings-row > .standings-points {
    -unity-text-align: middle-right;
}

#schedulePage .schedule-event-actions { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; }
#schedulePage .schedule-event-actions > .schedule-action-button {
    background-color: #182634; color: #f5f5f5; border-width: 1px; border-color: #009bdd;
    border-radius: 8px; min-height: 38px; min-width: 0; padding: 5px 10px;
    margin: 4px 0 0 6px; font-size: 12px; white-space: nowrap;
}
#schedulePage .schedule-action-button:hover,
#schedulePage .schedule-action-button:focus { background-color: #263e50; border-color: #55c4ef; }
#schedulePage .schedule-action-button:disabled { opacity: 0.45; }

#mailTab > .mail-response-badge {
    position: absolute; top: 2px; right: 3px;
    width: 14px; height: 14px; margin: 0; padding: 0;
    border-radius: 7px; background-color: #ffaf63; color: #10151e;
    -unity-text-align: middle-center; font-size: 12px;
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
}

/* Keep Balance and Next Race on the same row, including the empty-schedule state. */
.team-header-row > .team-header-balance,
.team-header-row > .team-header-next-race {
    align-self: stretch;
    justify-content: flex-start;
}
.team-header-balance > .team-header-caption,
.team-header-next-race > .team-header-caption { min-height: 18px; flex-shrink: 0; -unity-text-align: middle-left; }
.team-header-balance > .team-header-balance-amount,
.team-header-next-race > .team-header-track { min-height: 22px; flex-shrink: 0; -unity-text-align: upper-left; }
.team-header-balance > .team-header-date,
.team-header-next-race > .team-header-date { min-height: 18px; flex-shrink: 0; }

#mailPage > .mail-email { flex-grow: 3; flex-basis: 0; }
#mailPage > .mail-social { flex-grow: 1; flex-basis: 0; }
#mailPage .mail-reader { flex-grow: 3; flex-basis: 0; }
#mailPage .mail-inbox { flex-grow: 1; flex-basis: 0; }
#mailPage .mail-response-actions { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin-top: 8px; }
#mailPage .mail-response-actions > .mail-scenario-choice { flex-grow: 0; flex-shrink: 0; margin: 0 8px 8px 0; align-self: flex-start; }

/* Hiring views share the current Team/settings control styling. */
#recruitmentPage { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 12px 16px; background-color: #10151e; }
#recruitmentPage, #recruitmentPage Label, #recruitmentPage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf"); -unity-font-style: normal; color: #f5f5f5;
}
#recruitmentPage .recruitment-header { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
#recruitmentPage .settings-title { margin: 0; font-size: 24px; color: #009bdd; }
#recruitmentPage .recruitment-filter-control { flex-grow: 0; flex-shrink: 0; width: 260px; }
#recruitmentPage .recruitment-filter-control > .settings-note { margin: 0 0 3px; }
#recruitmentPage .recruitment-filter-control > .settings-button { margin: 0; }
#recruitmentPage .recruitment-status { height: 24px; min-height: 24px; flex-shrink: 0; margin: 2px 0 8px; white-space: normal; }
#recruitmentPage .recruitment-candidates-panel { flex-grow: 1; flex-basis: 0; min-height: 0; margin: 4px 0 0; padding: 20px 10px 8px; }
#recruitmentPage .team-home-heading { color: #009bdd; }
#recruitmentColumnHeadings { flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #009bdd; }
#recruitmentPage .recruitment-list { flex-grow: 1; flex-shrink: 1; min-height: 0; }
#recruitmentPage .recruitment-row { min-height: 88px; flex-shrink: 0; align-items: center; border-bottom-color: #263e50; }
#recruitmentPage .recruitment-row.results-grid-header { min-height: 30px; height: 30px; }
#recruitmentPage .recruitment-row:hover { background-color: #1c3444; }
#recruitmentPage .recruitment-row:hover .recruitment-photo-cell { background-color: #1c3444; }
#recruitmentPage .results-grid-cell { font-size: 12px; padding: 5px 8px; -unity-text-align: middle-left; white-space: normal; }
#recruitmentPage .recruitment-photo-cell { width: 72px; flex-shrink: 0; padding: 4px; }
#recruitmentPage .recruitment-portrait { width: 64px; height: 64px; background-color: transparent; }
#recruitmentPage .recruitment-candidate { flex-grow: 1.6; min-width: 165px; }
#recruitmentPage .recruitment-role { flex-grow: 1; min-width: 110px; }
#recruitmentPage .recruitment-skills { flex-grow: 2.4; min-width: 240px; }
#recruitmentPage .recruitment-salary { flex-grow: 0; flex-shrink: 0; flex-basis: 130px; -unity-text-align: middle-right; }
#recruitmentPage .recruitment-action { width: 82px; flex-shrink: 0; padding-left: 8px; }
#recruitmentPage .settings-button { border-radius: 8px; border-width: 1px; border-color: #009bdd; background-color: #182634; min-height: 34px; padding: 5px 12px; }
#recruitmentPage .settings-button:hover, #recruitmentPage .settings-button:focus { background-color: #263e50; border-color: #55c4ef; }
#recruitmentPage .settings-button:disabled { opacity: 0.45; }
#recruitmentPage .recruitment-actions { flex-grow: 0; flex-shrink: 0; margin-top: 10px; padding-top: 10px; border-top-color: #009bdd; }
.recruitment-role-choice:hover { background-color: #155374; border-color: #55c4ef; }

#recruitmentPage .recruitment-row { min-height: 112px; }
#recruitmentPage .recruitment-candidate { flex-grow: 1.8; min-width: 175px; }
#recruitmentPage .recruitment-role { flex-grow: 1; min-width: 100px; }
#recruitmentPage .recruitment-skills { flex-grow: 2.6; min-width: 215px; }
#recruitmentPage .recruitment-skills .employee-skill-row { min-height: 20px; height: 20px; }
#recruitmentPage .recruitment-skills .employee-skill-name { width: 90px; flex-shrink: 0; }
#recruitmentPage .recruitment-skills .employee-skill-track { min-width: 60px; height: 8px; }
#recruitmentPage .recruitment-skills .employee-skill-value { width: 42px; flex-shrink: 0; font-size: 12px; -unity-text-align: middle-right; }
#recruitmentPage .recruitment-salary { flex-basis: 120px; }
#recruitmentPage .recruitment-action { width: 78px; }

/* Keep employee hiring rows at a readable content width rather than stretching across wide windows. */
#recruitmentPage.employee-recruitment-page {
    width: 100%; max-width: 1080px; align-self: center;
}
#recruitmentPage.employee-recruitment-page .recruitment-candidate { flex-grow: 1.3; min-width: 175px; }
#recruitmentPage.employee-recruitment-page .recruitment-role { flex-grow: 0; flex-shrink: 0; flex-basis: 145px; min-width: 145px; }
#recruitmentPage.employee-recruitment-page .recruitment-skills { flex-grow: 1.5; min-width: 215px; }

#recruitmentPage .recruitment-header > .settings-title { flex-grow: 1; }
#recruitmentPage .recruitment-sort-control { flex-grow: 0; flex-shrink: 0; width: 235px; margin-left: 12px; }
#recruitmentPage .recruitment-sort-control > .settings-note { margin: 0 0 3px; }
#recruitmentPage .recruitment-sort-control > .settings-button { margin: 0; }

#recruitmentPage.driver-recruitment-page .recruitment-row { min-height: 148px; }
#recruitmentPage.driver-recruitment-page .recruitment-row.results-grid-header { min-height: 30px; }
#recruitmentPage.driver-recruitment-page .employee-skill-name { width: 110px; }
#recruitmentPage.driver-recruitment-page .employee-skill-value { width: 64px; }
#recruitmentPage.driver-recruitment-page .recruitment-skills { min-width: 290px; }
#employeesTab > .employee-driver-required-badge {
    position: absolute; top: 2px; right: 3px; width: 14px; height: 14px;
    margin: 0; padding: 0; border-radius: 7px; background-color: #c8323c; color: #ffffff;
    -unity-text-align: middle-center; font-size: 12px;
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf");
}

#recruitmentPage.driver-recruitment-page { width: 100%; max-width: 1080px; align-self: center; }
#recruitmentPage.driver-recruitment-page .recruitment-candidate { flex-grow: 1.2; min-width: 220px; white-space: normal; }
#recruitmentPage.driver-recruitment-page .recruitment-skills { flex-grow: 1.8; min-width: 340px; }
#recruitmentPage.driver-recruitment-page .recruitment-skills .employee-skill-name { width: 122px; min-width: 122px; margin-left: 0; margin-right: 8px; padding-left: 0; flex-shrink: 0; -unity-text-align: middle-left; }
#recruitmentPage.driver-recruitment-page .recruitment-skills .employee-skill-value { width: 74px; min-width: 74px; margin-left: 8px; margin-right: 0; padding-right: 0; flex-shrink: 0; white-space: nowrap; -unity-text-align: middle-right; }
#recruitmentPage.driver-recruitment-page .recruitment-skills .employee-skill-track { min-width: 90px; }

/* Team navigation uses consistent button geometry and room for status badges. */
#garageFooter { flex-direction: row; flex-wrap: nowrap; align-items: center; padding: 10px 12px; }
#garageFooter > .team-footer-button {
    flex-grow: 1; flex-shrink: 1; flex-basis: auto; min-width: 60px;
    height: 40px; min-height: 40px; max-height: 40px;
    margin: 0 3px; padding: 0 12px; font-size: 13px;
    -unity-text-align: middle-center; white-space: nowrap;
}
#garageFooter > #employeesTab { min-width: 116px; padding-right: 24px; }
#garageFooter > #mailTab { min-width: 68px; padding-right: 24px; }
#garageFooter > #scheduleTab { min-width: 84px; }
#garageFooter > #resultsTab { min-width: 72px; }
#garageFooter > #standingsTab { min-width: 92px; }
#garageFooter > #financesTab { min-width: 82px; }
#garageFooter > .team-calendar { flex-grow: 0; flex-shrink: 0; margin: 0; align-items: center; }
#garageFooter .team-date-panel { height: 40px; min-height: 40px; min-width: 96px; margin: 0 6px; padding: 0 6px; justify-content: center; }
#garageFooter .career-advance-controls {
    flex-direction: row;
    flex-shrink: 0;
    position: relative;
}
#garageFooter #toggleNextWeekButton {
    flex-grow: 0; flex-shrink: 0; min-width: 18px; width: 18px;
    height: 40px; min-height: 40px; max-height: 40px; margin: 0; padding: 0;
}
#garageFooter #nextWeekButton {
    display: none; position: absolute; bottom: 100%; left: 3px; right: 0;
    margin: 0 0 4px 0; height: 36px; min-height: 36px; padding: 0 7px;
    background-color: #10151e; border-color: #009bdd; white-space: nowrap;
}
#garageFooter #nextWeekButton:hover, #garageFooter #nextWeekButton:focus {
    background-color: #24394a;
}
#garageFooter .team-calendar.week-option-open .required-email-tooltip { margin-bottom: 46px; }
#garageFooter #nextDayButton {
    flex-grow: 0; flex-shrink: 0; min-width: 88px;
    height: 40px; min-height: 40px; max-height: 40px;
    margin: 0 3px; padding: 0 12px; -unity-text-align: middle-center;
}

#carMaintenancePage .component-repair-dialog {
    width: 480px; max-width: 90%; height: auto; min-height: 0;
    padding: 14px 18px; background-color: #10151e;
    border-width: 1px; border-color: #009bdd; border-radius: 12px;
}
#carMaintenancePage, #carMaintenancePage Label, #carMaintenancePage Button {
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf"); -unity-font-style: normal; color: #f5f5f5;
}
#carMaintenancePage .settings-group-heading { color: #009bdd; margin-bottom: 8px; }
#carMaintenancePage .component-repair-content { flex-grow: 0; flex-shrink: 0; }
#carMaintenancePage .component-repair-content > .settings-note { margin: 4px 0; white-space: normal; }
#carMaintenancePage .settings-button { min-height: 34px; margin: 4px 0; padding: 5px 12px; border-radius: 8px; border-width: 1px; border-color: #009bdd; background-color: #182634; }
#carMaintenancePage .settings-button:hover { background-color: #263e50; border-color: #55c4ef; }
#carMaintenancePage .settings-button:disabled { opacity: 0.45; }
#carMaintenancePage .component-repair-status { min-height: 20px; margin: 4px 0 0; white-space: normal; }
#carMaintenancePage .settings-footer { flex-grow: 0; flex-shrink: 0; margin-top: 6px; padding-top: 8px; border-top-color: #009bdd; }

#carMaintenancePage .settings-status-error { color: #b94747; }
#carMaintenancePage .settings-error-icon { color: #ffffff; }

.component-upgrade-confirmation {
    width: 480px; max-width: 90%; height: auto; min-height: 0; padding: 14px 18px;
    background-color: #10151e; border-width: 1px; border-color: #009bdd; border-radius: 12px;
    -unity-font-definition: url("../Fonts/OpenSans/OpenSans-Bold.ttf"); color: #f5f5f5;
}
.component-upgrade-confirmation > .settings-group-heading { color: #009bdd; margin-bottom: 6px; }
.component-upgrade-confirmation > .settings-note { white-space: normal; margin: 4px 0; }
.component-upgrade-confirmation > .settings-footer { flex-grow: 0; flex-shrink: 0; margin-top: 6px; padding-top: 8px; border-top-color: #009bdd; }
