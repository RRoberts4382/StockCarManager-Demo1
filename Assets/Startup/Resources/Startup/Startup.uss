#fireEmployeePrompt { padding: 0; border-width: 0; background-color: rgba(12, 21, 32, 0.76); }
.employee-dismissal-dialog { background-color: #10151e; border-color: #009bdd; }
.employee-dismissal-dialog > .actions { justify-content: flex-end; margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: #009bdd; }

/* Reserve enough width for the assignee and work description before other columns. */
#employeesPage .employee-work-mechanic {
    width: auto;
