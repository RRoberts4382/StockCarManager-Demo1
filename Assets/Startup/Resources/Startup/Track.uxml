<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Startup.uss" />
    <Style src="../Settings/SettingsControls.uss" />
    <Style src="../Fonts/GoogleSans/SettingsTypography.uss" />
    <ui:VisualElement name="trackScreen" class="screen">
        <ui:VisualElement name="raceViewport" class="race-viewport" />
        <ui:VisualElement class="header track-header ui-default-font">
            <ui:VisualElement class="track-title-row">
                <ui:Image name="trackVenueLogo" picking-mode="Ignore" style="width: 72px; height: 32px; flex-shrink: 0; margin-right: 8px; display: none;" />
                <ui:Label name="selectedTrackName" class="brand track-name" />
                <ui:Image name="trackSeriesLogo" picking-mode="Ignore" style="width: 72px; height: 32px; flex-shrink: 0; margin-left: 8px; display: none;" />
                <ui:Label name="trackSeriesName" class="brand track-name track-series-name" />
            </ui:VisualElement>
            <ui:VisualElement class="track-header-status">
                <ui:VisualElement class="track-header-left">
                    <ui:VisualElement name="practiceFlags" class="track-state-row track-icon-tooltip-target" style="display: none;">
                        <ui:VisualElement name="primaryPracticeFlag" style="width: 20px; height: 13px; margin-right: 5px;" />
                        <ui:VisualElement name="blackPracticeFlag" style="width: 20px; height: 13px; margin-right: 5px; background-color: #080808; border-color: #a0a0a0; border-width: 1px;" />
                        <ui:VisualElement name="checkeredFlag" style="display: none; width: 20px; height: 13px; margin-right: 5px;" />
                        <ui:Label class="garage-detail" />
                    </ui:VisualElement>
                    <ui:Label name="luckyDogLabel" class="garage-detail" style="display: none;" />
                </ui:VisualElement>
                <ui:VisualElement class="track-playback-area">
                    <ui:VisualElement class="track-playback">
                        <ui:Button name="playbackSpeedButton" text="1x &#x25BE;" tooltip="Playback speed" class="track-header-icon playback-speed-button" />
                        <ui:Button name="playSessionButton" text="&#x25B6;" tooltip="Play" class="track-header-icon" />
                        <ui:Button name="pauseSessionButton" text="&#x2161;" tooltip="Pause" class="track-header-icon" />
                    </ui:VisualElement>
                    <ui:Label name="cautionReasonLabel" class="track-caution-reason" picking-mode="Ignore" style="display: none;" />
                </ui:VisualElement>
                <ui:VisualElement class="track-header-right">
                    <ui:Button name="returnToGarageButton" class="track-header-icon" tooltip="Leave and end the current session">
                        <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="snapshotButton" class="track-header-icon" tooltip="Pause and save a snapshot of the last 15 seconds">
                        <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="resetCameraButton" class="track-header-icon" tooltip="Reset the track camera">
                        <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="visitGarageButton" class="track-header-icon" tooltip="Call your car to its pit stall" style="display: none;">
                        <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="trackSettingsButton" text="&#x2699;" tooltip="Open track settings" class="track-header-icon" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="track-content" picking-mode="Ignore">
            <ui:VisualElement name="trackCockpit" class="track-cockpit" picking-mode="Ignore">
                <ui:VisualElement class="cockpit-mirror" picking-mode="Ignore">
                    <ui:VisualElement name="cockpitMirrorImage" class="cockpit-mirror-image" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="cockpitDashboard" class="cockpit-dashboard" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="trackStandings" class="track-standings ui-default-font" picking-mode="Ignore">
                <ui:VisualElement class="scoring-header">
                    <ui:VisualElement name="scoringFlag" class="scoring-flag track-icon-tooltip-target" />
                    <ui:VisualElement class="scoring-header-content">
                        <ui:VisualElement class="scoring-header-line scoring-header-top">
                            <ui:Label name="scoringSession" class="scoring-session" />
                            <ui:Label name="scoringSessionRemaining" class="scoring-remaining" />
                        </ui:VisualElement>
                        <ui:VisualElement name="scoringRaceLine" class="scoring-header-line">
                            <ui:Label name="scoringRaceLap" class="scoring-session" />
                            <ui:Label name="scoringRaceRemaining" class="scoring-remaining" />
                        </ui:VisualElement>
                        <ui:VisualElement name="scoringRaceProgress" class="scoring-race-progress" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="toggleTrackStandings" text="&lt;" tooltip="Collapse Scoring Bug" class="scoring-toggle track-icon-tooltip-target" />
                    <ui:Button name="scoringColumnButton" class="scoring-toggle scoring-column-toggle track-icon-tooltip-target">
                        <ui:VisualElement class="track-icon-art scoring-column-icon" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="trackTimingRows" class="timing-rows" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
            </ui:VisualElement>
            <ui:VisualElement class="track-right-dock" picking-mode="Ignore">
                <ui:VisualElement name="trackMapWidget" class="track-map-widget" picking-mode="Ignore">
                    <ui:VisualElement name="trackSessionMap" class="track-session-map" picking-mode="Ignore" />
                    <ui:Button name="toggleTrackMap" text="&gt;" tooltip="Collapse track map" class="standings-toggle track-map-toggle track-icon-tooltip-target" />
                </ui:VisualElement>
                <ui:VisualElement name="trackPitSettings" class="track-pit-controls ui-default-font">
                    <ui:VisualElement class="track-player-panel">
                        <ui:VisualElement class="pit-readouts">
                            <ui:VisualElement class="pit-tires">
                                <ui:VisualElement class="pit-tire">
                                    <ui:Label text="LF" />
                                    <ui:Toggle name="pitTire0" tooltip="Replace LF tire" />
                                    <ui:VisualElement class="pit-tire-bar"><ui:VisualElement name="pitTireFill0" class="pit-meter-fill" /></ui:VisualElement>
                                    <ui:Label name="pitTireWear0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pit-tire">
                                    <ui:Label text="RF" />
                                    <ui:Toggle name="pitTire1" tooltip="Replace RF tire" />
                                    <ui:VisualElement class="pit-tire-bar"><ui:VisualElement name="pitTireFill1" class="pit-meter-fill" /></ui:VisualElement>
                                    <ui:Label name="pitTireWear1" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pit-tire">
                                    <ui:Label text="LR" />
                                    <ui:Toggle name="pitTire2" tooltip="Replace LR tire" />
                                    <ui:VisualElement class="pit-tire-bar"><ui:VisualElement name="pitTireFill2" class="pit-meter-fill" /></ui:VisualElement>
                                    <ui:Label name="pitTireWear2" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pit-tire">
                                    <ui:Label text="RR" />
                                    <ui:Toggle name="pitTire3" tooltip="Replace RR tire" />
                                    <ui:VisualElement class="pit-tire-bar"><ui:VisualElement name="pitTireFill3" class="pit-meter-fill" /></ui:VisualElement>
                                    <ui:Label name="pitTireWear3" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="pit-levels">
                                <ui:Label name="playerCarStatus" />
                                <ui:VisualElement class="pit-level-bar"><ui:VisualElement name="pitFuelFill" class="pit-meter-fill" /></ui:VisualElement>
                                <ui:Toggle name="refuelAtStop" tooltip="Add fuel at the next pit stop" value="true" />
                                <ui:Slider name="pitFuelAmount" low-value="0" high-value="18" value="18" />
                                <ui:Label name="pitFuelAmountLabel" />
                                <ui:Label name="pitDamageLabel" />
                                <ui:VisualElement class="pit-level-bar"><ui:VisualElement name="pitDamageFill" class="pit-meter-fill pit-damage-fill" /></ui:VisualElement>
                                <ui:Slider name="pitRepairAmount" low-value="0" high-value="100" value="0" />
                                <ui:Label name="pitRepairAmountLabel" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="requestPitStop" text="Pit Next Time" tooltip="Request a pit stop on the next lap" class="settings-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="trackFooter" class="footer track-footer ui-default-font">
            <ui:VisualElement class="track-footer-driving">
                <ui:VisualElement name="footerThrottle" class="driving-meter track-icon-tooltip-target" tooltip="Throttle 0%">
                    <ui:VisualElement class="driving-meter-bar"><ui:VisualElement name="footerThrottleFill" class="driving-meter-fill throttle-fill" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="footerBrake" class="driving-meter track-icon-tooltip-target" tooltip="Brake 0%">
                    <ui:VisualElement class="driving-meter-bar"><ui:VisualElement name="footerBrakeFill" class="driving-meter-fill brake-fill" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="footerFuel" class="driving-meter track-icon-tooltip-target" tooltip="Fuel">
                    <ui:VisualElement class="driving-meter-bar"><ui:VisualElement name="footerFuelFill" class="driving-meter-fill fuel-fill" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-shrink: 0; margin-right: 3px;">
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 2px;">
                        <ui:VisualElement name="footerTireLeftFront" class="driving-meter-bar track-icon-tooltip-target" style="height: 14px; margin-right: 2px;">
                            <ui:VisualElement name="footerTireLeftFrontFill" class="driving-meter-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="footerTireRightFront" class="driving-meter-bar track-icon-tooltip-target" style="height: 14px;">
                            <ui:VisualElement name="footerTireRightFrontFill" class="driving-meter-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row;">
                        <ui:VisualElement name="footerTireLeftRear" class="driving-meter-bar track-icon-tooltip-target" style="height: 14px; margin-right: 2px;">
                            <ui:VisualElement name="footerTireLeftRearFill" class="driving-meter-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="footerTireRightRear" class="driving-meter-bar track-icon-tooltip-target" style="height: 14px;">
                            <ui:VisualElement name="footerTireRightRearFill" class="driving-meter-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="footerMph" text="0.0 MPH" class="track-footer-mph" />
                <ui:Label name="footerRpm" text="RPM 900" class="track-footer-engine" />
                <ui:Label name="footerGear" text="Gear 1" class="track-footer-engine" />
            </ui:VisualElement>
            <ui:VisualElement class="track-footer-center">
                <ui:VisualElement class="track-passing-criteria">
                    <ui:Label text="Passing" class="track-passing-label" picking-mode="Ignore" />
                    <ui:Label text="Easier" picking-mode="Ignore" />
                    <ui:SliderInt name="passingCriteriaSlider" low-value="0" high-value="100" value="50"
                                  class="track-passing-slider track-icon-tooltip-target"
                                  tooltip="Move left to ease the requirements for new 007 passing attempts." />
                    <ui:Label text="Strict" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="track-footer-metrics">
                    <ui:Label name="trackFpsLabel" text="FPS --" class="muted" />
                    <ui:Label name="snapshotStatus" class="garage-detail" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="track-footer-pit">
                <ui:Button name="cycleTrackCameraButton" tooltip="Choose a track camera" class="track-header-icon">
                    <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="trackCameraAngle" text="Player" class="garage-detail" />
                <ui:Label name="playerPitStatus" class="garage-detail" />
                <ui:Button name="pitSettingsButton" tooltip="Show pit stop settings" class="track-header-icon pit-settings-button">
                    <ui:VisualElement class="track-icon-art" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="trackIconTooltip" class="track-icon-tooltip ui-default-font" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
